#!/usr/bin/env python3
"""flowkit-tmux: the Claude Code sessions in tmux at a glance, for the flowkit tmux kit.

  flowkit-tmux waiting        status-bar job: marks each Claude pane with its state
                              (@flowkit_state: working, waiting, idle), each tab with how many
                              of its sessions wait on you (@flowkit_wait), each story and adhoc
                              tab with its most urgent state (@flowkit_tab), prints the total;
                              a claude pane left at a start-up prompt waits on you too, and is
                              listed in ~/.claude/flowkit/parked.json while it does;
                              starts again the waiter of a session stopped on a usage limit;
                              nudges the sessions parked on a question once the away flag
                              takes effect; with remind=on in handoff.conf it sends the
                              reminders (`handoff.py remind`);
                              with autoclose=on in handoff.conf it also closes a finished slice's
                              pane once its successor runs or its watch is open, and finished
                              story tabs
  flowkit-tmux closable       dry run: the panes the tick would close, closing nothing
  flowkit-tmux list [client]  numbered list of every session, waiting first; a number jumps there
  flowkit-tmux dialog         reads a pane's screen on stdin: prints the first line of the dialog
                              it ends on, exit 1 when it ends on none (flowkit-spawn asks)
  flowkit-tmux help           the cheat sheet

The kit's conf calls the copy at ~/.local/bin/flowkit-tmux, which the handoff plugin moves
forward to its own version at every session start; the copy finds the plugin's other files
through installed_plugins.json. A session is mapped to its pane through its parent
processes, up to the pane's shell; background sessions have no pane and are listed apart.
"""
import contextlib
import fcntl
import functools
import io
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

os.environ["PATH"] = os.pathsep.join(
    [str(Path.home() / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", "")])
SEP = "\x1f"
VERSION = re.compile(r"^\d+\.\d+\.\d+$")  # a pane running claude shows its version as the command
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "flowkit"
CLAUDE = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
URGENCY = ("needs you", "error", "limit", "stalled", "running", "watching", "done")  # a tab shows its first
STOPPED = ("error", "limit")  # the last turn ended on an API error, or on a usage limit
STALL = 15 * 60
SESSION_LINE = re.compile(r"^Session: ([0-9a-f-]{36})\b", re.M)  # a recorded close names its session
HEADING = re.compile(r"^## (.+?) · \d{4}-\d\d-\d\d", re.M)  # a close section, or the reporter's final report
FINAL = re.compile(r"^## Final report · (\d{4}-\d\d-\d\d \d\d:\d\d)", re.M)
PROMISED = re.compile(r"^Next: (?:spawned|started|watching) (.*)$", re.M)  # the sessions a close launched, the watches it registered
COORDINATOR = re.compile(r"^Coordinator: (\S+)", re.M)  # a coordination board names its coordinator
COORD_NAME = re.compile(r"(?:^|-)coord")  # coord-1, story-coord, story-coordinator
SHELLS = {"zsh", "bash", "sh", "fish", "dash", "ksh", "tcsh"}
QUIET = 5 * 60  # a session is closed only once its transcript and forks have been still this long
BACKFILL = 15 * 60  # an unfinished story this quiet rings its reporter, who records the missing closes
GRACE = 5 * 60  # the story file sits this long after its last write before the tab goes
RING_EVERY = 5 * 60
SPAWN_GRACE = 2 * 60  # a pane flowkit-spawn stamped @flowkit_born this recently is still starting its claude
HINT = re.compile(r"enter to (?:confirm|select|continue)|esc to (?!interrupt)\w+", re.I)  # the key hints under a dialog
RULE = re.compile(r"^\s*[─-╿]{10,}\s*$")  # a row of box-drawing characters
PARKED = 60  # a dialog this long on a claude pane with no session listed is a start-up prompt nobody answered
CACHE = Path(tempfile.gettempdir()) / f"flowkit-tmux-{os.getuid()}.json"  # the last status line and when
FRESH = 10  # a status line this young is printed again without asking `claude agents`


def run(*cmd):
    out = subprocess.run(cmd, capture_output=True, text=True)
    return out.stdout if out.returncode == 0 else None


def tmux(*args):
    return run("tmux", *args) or ""


def agents():
    out = run("claude", "agents", "--json")
    try:
        rows = json.loads(out) if out else None
    except ValueError:
        return None
    return rows if isinstance(rows, list) else None


def panes():
    fmt = SEP.join(["#{pane_pid}", "#{pane_id}", "#{session_name}", "#{window_id}", "#{window_index}",
                    "#{window_name}", "#{pane_index}", "#{pane_current_command}", "#{@flowkit_state}",
                    "#{@flowkit_story}#{@flowkit_adhoc}", "#{@flowkit_story}", "#{@flowkit_hold}#{@cc_hold}",
                    "#{@flowkit_rung}", "#{@flowkit_born}", "#{@flowkit_parked}"])
    keys = ("pid", "id", "sess", "wid", "widx", "wname", "pidx", "cmd", "state", "story", "slug", "hold", "rung",
            "born", "parked")
    return [dict(zip(keys, line.split(SEP)))
            for line in tmux("list-panes", "-a", "-F", fmt).splitlines() if line]


def placed(rows, pane_list):
    """(pane, agent row) for every interactive session that runs inside a tmux pane."""
    parent = {}
    for line in (run("ps", "-axo", "pid=,ppid=") or "").splitlines():
        parts = line.split()
        if len(parts) == 2:
            parent[parts[0]] = parts[1]
    by_pid = {p["pid"]: p for p in pane_list}
    found = []
    for row in rows:
        if row.get("kind") != "interactive" or row.get("pid") is None:
            continue
        pid = str(row["pid"])
        for _ in range(4):
            if pid in by_pid:
                found.append((by_pid[pid], row))
                break
            pid = parent.get(pid, "")
    return found


def state(row):
    return {"busy": "working", "waiting": "waiting", "idle": "idle"}.get(row.get("status"), row.get("status") or "")


@functools.lru_cache(None)
def closed(slug):
    """Session ids with a close recorded in the story's file; the adhoc tab has no story, so all files."""
    paths = (CLAUDE / "stories").glob("*.md") if slug == "adhoc" else [CLAUDE / "stories" / f"{slug}.md"]
    ids = set()
    for path in paths:
        try:
            ids.update(SESSION_LINE.findall(path.read_text(errors="replace")))
        except OSError:
            pass
    return ids


def live(row):
    """The session's ~/.claude/sessions/<pid>.json, only if it is still this session's: pids are reused."""
    try:
        data = json.loads((CLAUDE / "sessions" / f"{row.get('pid')}.json").read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) and data.get("sessionId") == row.get("sessionId") else {}


def untouched(sid, cutoff):
    """Neither the transcript nor a fork's under <sid>/subagents/ changed after cutoff."""
    for transcript in (CLAUDE / "projects").glob(f"*/{sid}.jsonl"):
        forks = transcript.with_suffix("") / "subagents"
        for path in [transcript, forks, *(forks.glob("*") if forks.is_dir() else [])]:
            try:
                if path.stat().st_mtime > cutoff:
                    return False
            except OSError:
                pass
    return True


def tab_state(row, slug):
    """The pane's word for its tab label, or "" for none."""
    sid = row.get("sessionId") or ""
    status = row.get("status")
    if status == "waiting":
        return "needs you"
    if sid:
        try:
            rec = json.loads((CLAUDE / "flowkit" / "retry" / f"{sid}.json").read_text())
            return "limit" if isinstance(rec, dict) and rec.get("kind") == "rate_limit" else "error"
        except FileNotFoundError:
            pass
        except (OSError, ValueError):
            return "error"
    info = live(row) if sid else {}
    if status == "busy":
        return "watching" if info.get("status") == "shell" and sid in closed(slug) else "running"
    if status != "idle" or not sid:
        return ""
    if sid in closed(slug):
        return "done"
    if (row.get("name") or "").endswith("-report"):
        return ""  # a reporter idles between closes; that is not a stall
    since = (info.get("statusUpdatedAt") or 0) / 1000
    cutoff = time.time() - STALL
    return "stalled" if since and since <= cutoff and untouched(sid, cutoff) else ""


def setting(key):
    """A key=value line of handoff.conf, the plugin's own settings; the last one wins."""
    value = ""
    try:
        for line in (CONFIG / "handoff.conf").read_text().splitlines():
            k, sep, v = line.partition("=")
            if sep and k.strip() == key:
                value = v.strip()
    except OSError:
        pass
    return value


def watched():
    """Story slug → the names of its open watches: flowkit/watches/<name>.json, which goes once the
    watch's own section is recorded (scripts/watch.py)."""
    out = {}
    for path in (CLAUDE / "flowkit" / "watches").glob("[!.]*.json"):
        try:
            arm = json.loads(path.read_text())
        except (OSError, ValueError):
            continue
        if isinstance(arm, dict) and arm.get("name") == path.stem and arm.get("story"):
            out.setdefault(arm["story"], set()).add(arm["name"])
    return out


def story_complete(text):
    """Every session a close launched, and every watch it registered, has a section of its own."""
    have = set(HEADING.findall(text)) - {"Final report"}
    want = set()
    for rest in PROMISED.findall(text):
        want.update(n.strip() for n in re.split(r",\s*", re.sub(r"\s*\(.*$", "", rest)))
    return want - {"", "none"} <= have


def story_reported(text):
    """When the reporter's final report was written, if it is newer than the last close (a story can
    go on after one), else 0."""
    last = {}
    for m in HEADING.finditer(text):
        last[m.group(1) == "Final report"] = m.start()
    if last.get(True, -1) < last.get(False, -1):
        return 0
    try:
        return time.mktime(time.strptime(FINAL.findall(text)[-1], "%Y-%m-%d %H:%M"))
    except (IndexError, ValueError):
        return 0


def ring(pane, now):
    """Wake the reporter so it writes the final report; at most once every 5 min."""
    rung = pane.get("rung") or ""
    if rung.isdigit() and now - int(rung) < RING_EVERY:
        return
    tmux("set-option", "-p", "-t", pane["id"], "@flowkit_rung", str(int(now)),
         ";", "send-keys", "-t", pane["id"], "C-u", ";", "send-keys", "-t", pane["id"], "report now", "Enter")


def starting(pane, now):
    """flowkit-spawn stamped the pane, or its tab, this recently: its claude is still coming up."""
    born = pane.get("born") or ""
    return born.isdigit() and now - int(born) < SPAWN_GRACE


def dialog(rows):
    """The first line of the dialog a screen ends on, "" when it ends on none. A dialog shows its
    key hints (`Enter to confirm · Esc to cancel`) in the bottom 8 rows; a hint quoted further up,
    or a session at work (`esc to interrupt`), is none. Its first line is the first row with a
    letter below the last rule row above the hints, without its frame."""
    rows = [row.rstrip() for row in rows]
    while rows and not rows[-1]:
        rows.pop()
    hint = next((i for i in range(len(rows) - 1, max(len(rows) - 9, -1), -1) if HINT.search(rows[i])), None)
    if hint is None:
        return ""
    top = max((i for i in range(hint) if RULE.match(rows[i])), default=-1)
    for row in rows[top + 1:hint + 1]:
        text = " ".join(row.strip(" \t│┃|").split())
        if re.search(r"[^\W\d_]", text):
            return text[:80]
    return ""


def parked(pane_list, listed, now):
    """The panes parked at a start-up prompt, as (pane, the dialog's first line, since), and the
    tmux writes that keep @flowkit_parked. Such a pane runs claude, no session is listed for it
    (before a start-up prompt is answered there is none), and its screen ends on a dialog that has
    stood for a minute: the launch was stamped (@flowkit_born) or the dialog first seen
    (@flowkit_parked, kept here) that long ago. A claude pane with no dialog on it (`claude
    agents`, a picker, a `-p` job) is none."""
    out, cmds = [], []
    for p in pane_list:
        line = ""
        if p["id"] not in listed and VERSION.match(p["cmd"]):
            line = dialog(tmux("capture-pane", "-p", "-t", p["id"]).splitlines())
        seen = p.get("parked") or ""
        if line and not seen:
            cmds += [";", "set-option", "-p", "-t", p["id"], "@flowkit_parked", str(int(now))]
        elif seen and not line:
            cmds += [";", "set-option", "-p", "-u", "-t", p["id"], "@flowkit_parked"]
        if line and any(at.isdigit() and now - int(at) > PARKED for at in (seen, p.get("born") or "")):
            out.append((p, line, int(seen) if seen.isdigit() else int(now)))
    return out, cmds


def note_parked(stuck, now):
    """flowkit/parked.json, for the board and the reminders: the panes parked at a start-up prompt,
    written again at every tick while there is one (`at` says how fresh it is), gone with the last."""
    path = CLAUDE / "flowkit" / "parked.json"
    try:
        if not stuck:
            path.unlink(missing_ok=True)
            return
        path.parent.mkdir(parents=True, exist_ok=True)
        fresh = path.with_suffix(".tmp")
        fresh.write_text(json.dumps({"at": int(now), "panes": [
            {"pane": p["id"], "tab": p["wname"], "index": p["pidx"], "story": p.get("slug") or "", "line": line,
             "since": since} for p, line, since in stuck]}))
        os.replace(fresh, path)
    except OSError:
        pass


def terminate(pid):
    """SIGTERM, then up to 5 s for the process to go; True once it has."""
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(10):
            time.sleep(0.5)
            os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except OSError:
        pass
    return False


def close_stories(pane_list, found, words):
    """A story whose sessions are all finished goes as a whole, its reporter last. Only tabs marked
    @flowkit_story are looked at; @flowkit_hold (or the older @cc_hold) on a tab keeps its story."""
    now = time.time()
    rows = {p["id"]: r for p, r in found}
    arms = watched()
    stories = {}
    for p in pane_list:
        if p.get("slug"):
            stories.setdefault(p["slug"], []).append(p)
    for slug, members in stories.items():
        path = CLAUDE / "stories" / f"{slug}.md"
        try:
            text, written = path.read_text(errors="replace"), path.stat().st_mtime
        except OSError:
            continue
        if any(p.get("hold") for p in members):
            continue
        if any(starting(p, now) for p in members):
            continue  # a shell flowkit-spawn just typed a launch into, before claude agents lists it
        if any(p["id"] not in rows and p["cmd"].lstrip("-") not in SHELLS for p in members):
            continue  # a pane runs something else, or a claude that claude agents does not list
        claudes = [(p, rows[p["id"]]) for p in members if p["id"] in rows]
        if any(r.get("status") != "idle" or words.get(p["id"]) in STOPPED for p, r in claudes):
            continue  # at work, waiting on the user, watching, in error or at a usage limit
        report = [p for p, r in claudes if (r.get("name") or "").endswith("-report")]
        reported, complete = story_reported(text), story_complete(text)
        if not (reported or not claudes or (complete and not report)):
            if report and slug not in arms and (
                    complete or all(untouched(r.get("sessionId") or "", now - BACKFILL) for _, r in claudes)):
                ring(report[0], now)  # never while a watch is open: its section rings the reporter itself
            continue
        if now - written < GRACE or not all(untouched(r.get("sessionId") or "", now - QUIET) for _, r in claudes):
            continue
        if any(r.get("sessionId") not in closed(slug) and (r.get("startedAt") or now * 1000) / 1000 > reported + 60
               for p, r in claudes if p not in report):
            continue  # a session needs its own close, unless it started before a final report that covers it
        fresh = {p["id"]: p for p in panes()}  # the list is a `claude agents` old: a launch may have landed since
        if any(starting(fresh.get(p["id"], p), now) or
               (p["id"] not in rows and fresh.get(p["id"], p)["cmd"].lstrip("-") not in SHELLS) for p in members):
            continue  # stamped, or no longer a bare shell, since the list
        for p in [p for p in members if p["id"] not in rows] + [p for p, _ in claudes if p not in report] + report:
            if p["id"] in rows and not terminate(int(rows[p["id"]]["pid"])):
                break  # it would not go: the rest stay, the reporter with them
            tmux("kill-pane", "-t", p["id"])


def coordinators():
    """The names on the coordination boards (`Coordinator: <name> · …`)."""
    names = set()
    for path in (CLAUDE / "coordination").glob("*.md"):
        try:
            names.update(m.strip("`") for m in COORDINATOR.findall(path.read_text(errors="replace")))
        except OSError:
            pass
    return names


def successors(slug, sid):
    """The sessions the close of sid launched and the watches it registered, from its section of
    the story file."""
    try:
        text = (CLAUDE / "stories" / f"{slug}.md").read_text(errors="replace")
    except OSError:
        return set()
    for section in re.split(r"^(?=## )", text, flags=re.M):
        if re.search(rf"^Session: {re.escape(sid)}\b", section, re.M):
            names = set()
            for rest in PROMISED.findall(section):
                names.update(n.strip() for n in re.split(r",\s*", re.sub(r"\s*\(.*$", "", rest)))
            return names - {"", "none"}
    return set()


def finished_panes(rows, found, words):
    """Story panes whose slice is over: the close is recorded and a session it launched runs, or a
    watch it registered is open. Never the reporter, a coordinator, the adhoc tab (no story mark),
    a held tab, or a session at work, waiting on the user, in error, at a usage limit or touched
    in the last 5 minutes."""
    now = time.time()
    live = {r.get("name") for r in rows if r.get("pid")}  # a successor in the background has no pane
    arms = watched()
    coords = coordinators()
    out = []
    for p, r in found:
        name, sid = r.get("name") or "", r.get("sessionId") or ""
        if not p.get("slug") or p.get("hold") or starting(p, now) or not sid:
            continue
        if r.get("status") != "idle" or words.get(p["id"]) in STOPPED:
            continue
        if name.endswith("-report") or name in coords or COORD_NAME.search(name):
            continue
        if sid not in closed(p["slug"]) or not untouched(sid, now - QUIET):
            continue
        if (successors(p["slug"], sid) - {name}) & (live | arms.get(p["slug"], set())):
            out.append((p, r))
    return out


def close_panes(rows, found, words):
    """Closes the finished panes; True when one went."""
    done = finished_panes(rows, found, words)
    if not done:
        return False
    fresh = {p["id"]: p for p in panes()}  # the list is a `claude agents` old
    for p, r in done:
        now_p = fresh.get(p["id"])
        if not now_p or now_p["pid"] != p["pid"] or starting(now_p, time.time()):
            continue
        if terminate(int(r["pid"])):
            tmux("kill-pane", "-t", p["id"])
    return True


def waiting():
    pane_list = panes()
    found, rows = [], []
    if any(VERSION.match(p["cmd"]) for p in pane_list):
        rows = agents()
        if rows is None:
            return  # claude agents failed: leave the marks as they are
        found = placed(rows, pane_list)
    want = {p["id"]: state(r) for p, r in found}
    count, tab, words = {}, {}, {}
    for p, r in found:
        if r.get("status") == "waiting":
            count[p["wid"]] = count.get(p["wid"], 0) + 1
        word = words[p["id"]] = tab_state(r, p.get("story")) if p.get("story") else ""
        if word and (p["wid"] not in tab or URGENCY.index(word) < URGENCY.index(tab[p["wid"]])):
            tab[p["wid"]] = word
    now = time.time()
    stuck, cmds = parked(pane_list, set(want), now)
    for p, _, _ in stuck:  # no session to ask: the pane itself waits on the user
        want[p["id"]] = "waiting"
        count[p["wid"]] = count.get(p["wid"], 0) + 1
        if p.get("story"):
            tab[p["wid"]] = "needs you"
    note_parked(stuck, now)
    arms = watched()
    for p in pane_list:  # a story with a watch open is watched, while nothing in its tab is more urgent
        if p.get("slug") in arms and tab.get(p["wid"], "done") == "done":
            tab[p["wid"]] = "watching"
    for p in pane_list:
        if p["id"] in want and want[p["id"]] != p["state"]:
            cmds += [";", "set-option", "-p", "-t", p["id"], "@flowkit_state", want[p["id"]]]
        elif p["id"] not in want and p["state"]:
            cmds += [";", "set-option", "-p", "-u", "-t", p["id"], "@flowkit_state"]
    for line in tmux("list-windows", "-a", "-F", SEP.join(["#{window_id}", "#{@flowkit_wait}", "#{@flowkit_tab}"])).splitlines():
        wid, have, label = (line.split(SEP) + ["", ""])[:3]
        n = count.get(wid, 0)
        if n and have != str(n):
            cmds += [";", "set-option", "-w", "-t", wid, "@flowkit_wait", str(n)]
        elif not n and have:
            cmds += [";", "set-option", "-w", "-u", "-t", wid, "@flowkit_wait"]
        word = tab.get(wid, "")
        if word and label != word:
            cmds += [";", "set-option", "-w", "-t", wid, "@flowkit_tab", word]
        elif not word and label:
            cmds += [";", "set-option", "-w", "-u", "-t", wid, "@flowkit_tab"]
    if cmds:
        tmux(*cmds[1:])
    if setting("autoclose") == "on" and not close_panes(rows, found, words):
        close_stories(pane_list, found, words)
    total = sum(count.values())
    if total:
        print(f"#[reverse] ⚑ {total} need{'s' if total == 1 else ''} you #[noreverse] ", end="")


def plugin_root():
    """The handoff plugin whose files this copy uses: its own when they sit beside it (the repo, the
    plugin cache), else the newest handoff in installed_plugins.json, since the kit's copy in
    ~/.local/bin has nothing beside it."""
    own = Path(__file__).resolve().parent.parent
    if (own / ".claude-plugin" / "plugin.json").is_file():
        return own
    def version(root):
        try:
            return tuple(int(n) for n in json.loads((root / ".claude-plugin" / "plugin.json").read_text())["version"].split("."))
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            return None
    try:
        entries = json.loads((CLAUDE / "plugins" / "installed_plugins.json").read_text())["plugins"]["handoff@flowkit"]
        roots = [Path(e["installPath"]) for e in entries]
    except (OSError, ValueError, KeyError, TypeError):
        return own
    found = [(v, root) for root in roots if (root / "scripts" / "capacity.py").is_file() and (v := version(root))]
    return max(found)[1] if found else own


def drain():
    """The capacity queue drains on the tick too, so a slot freed by a session that died or sat
    idle starts the next queued launch. An empty queue costs one directory read; else
    `capacity.py drain` runs detached, at most every FLOWKIT_CAPACITY_POLL (15) seconds."""
    state = CLAUDE / "capacity"
    try:
        if not any(e.name.endswith(".json") for e in os.scandir(state / "queue")):
            return
    except OSError:
        return
    try:
        if time.time() - (state / ".tick").stat().st_mtime < float(os.environ.get("FLOWKIT_CAPACITY_POLL") or 15):
            return
    except OSError:
        pass
    try:
        (state / ".tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "capacity.py"), "drain"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def watch():
    """An open watch needs its poller (scripts/watch.py): when its process is gone or its heartbeat,
    poller.pid's mtime, is older than three minutes, `watch.py run` starts detached, at most once a
    minute; a poller that still runs makes that one exit. No watch costs one directory read."""
    state = CLAUDE / "flowkit" / "watches"
    try:
        if not any(e.name.endswith(".json") for e in os.scandir(state)):
            return
    except OSError:
        return
    try:
        os.kill(int((state / "poller.pid").read_text()), 0)
        if time.time() - (state / "poller.pid").stat().st_mtime < 180:
            return
    except (OSError, ValueError):
        pass
    try:
        if time.time() - (state / ".tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        (state / ".tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "watch.py"), "run"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def relogged(rec):
    """The login a limit record's session stopped on is another account's now: its account file
    (<CLAUDE_CONFIG_DIR as the session had it>/.claude.json, ~/.claude.json when it had none) names
    other ids than the record keeps."""
    if not rec.get("account"):
        return False
    try:
        who = json.loads((Path(rec.get("config") or Path.home()) / ".claude.json").read_text()).get("oauthAccount")
    except (OSError, ValueError, AttributeError):
        return False
    return isinstance(who, dict) and bool(who.get("accountUuid")) and \
        {"account": who["accountUuid"], "organization": who.get("organizationUuid")} != rec["account"]


def limits():
    """A session stopped on a usage limit needs its waiter (`handoff.py retry-wait`), which the
    StopFailure hook starts and which lives until the record goes: one that died is started again,
    at most once a minute. Never for a record its waiter is done with (continued, left to the user
    or to Claude Code's own wait) unless the account under its session changed since, which opens
    it again; never with limit resume off, or for a session that is gone. No record costs one
    directory read."""
    state = CLAUDE / "flowkit" / "retry"
    try:
        names = [e.name for e in os.scandir(state) if e.name.endswith(".json") and not e.name.startswith(".")]
    except OSError:
        return
    if not names:
        return
    try:
        if time.time() - (state / ".tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        (state / ".tick").touch()
    except OSError:
        return
    for name in names:
        try:
            rec = json.loads((state / name).read_text())
            if rec.get("kind") != "rate_limit" or not rec.get("resume") or \
                    (rec.get("handled") == rec.get("at") and not relogged(rec)):
                continue
            os.kill(int(rec["pid"]), 0)
        except (OSError, ValueError, TypeError, AttributeError, KeyError):
            continue
        try:
            with (state / f"{name[:-5]}.lock").open() as lock:  # its waiter holds an flock on it while it lives
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except FileNotFoundError:
            pass
        except OSError:
            continue
        try:
            subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "handoff.py"), "retry-wait", name[:-5]],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass


def away_nudge():
    """`handoff.py away` sets the flag five minutes ahead; once it is in effect, the sessions parked
    on a question get the nudge (`handoff.py away-nudge`, which checks the time and nudges once per
    flag), started detached at most once a minute until it has run for this flag. No flag costs one
    read."""
    try:
        text = (CLAUDE / "away").read_text()
    except OSError:
        return
    state = CLAUDE / "flowkit"
    try:
        if (state / "away-nudged").read_text() == text:
            return
    except OSError:
        pass
    try:
        if time.time() - (state / ".away-tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        state.mkdir(parents=True, exist_ok=True)
        (state / ".away-tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "handoff.py"), "away-nudge"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def remind():
    """With remind=on in handoff.conf, `handoff.py remind` starts detached at most once a minute: it
    tells the user what waits on them while they are neither away nor at the computer, and its own
    lock keeps one pass at a time. Off costs one read of handoff.conf."""
    if setting("remind") != "on":
        return
    state = CLAUDE / "flowkit"
    try:
        if time.time() - (state / ".remind-tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        state.mkdir(parents=True, exist_ok=True)
        (state / ".remind-tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "handoff.py"), "remind"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def status_line():
    """`waiting` for the status bar. tmux reruns a #() job at every redraw that falls in a new
    second, not every status-interval, so the line comes from the cache while it is younger than
    FRESH seconds, and a run that overlaps another prints the cache too (the lock is never waited
    for)."""
    try:
        cached = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        cached = {}
    if not isinstance(cached, dict):
        cached = {}
    line = cached.get("line", "")
    if time.time() - cached.get("at", 0) < FRESH:
        print(line, end="")
        return
    with CACHE.with_suffix(".lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            print(line, end="")
            return
        out = io.StringIO()
        with contextlib.redirect_stdout(out):
            waiting()
        drain()
        watch()
        limits()
        away_nudge()
        remind()
        line = out.getvalue()
        fresh = CACHE.with_suffix(".tmp")
        fresh.write_text(json.dumps({"at": time.time(), "line": line}))
        os.replace(fresh, CACHE)
    print(line, end="")


def age(started_ms):
    s = int(time.time() - (started_ms or 0) / 1000)
    return f"{s // 60}m" if s < 3600 else f"{s // 3600}h" if s < 172800 else f"{s // 86400}d"


def pause():
    try:
        input("  Enter to close ")
    except EOFError:
        pass


def list_sessions(client=""):
    if "#{" in client:
        client = ""
    rows = agents()
    if rows is None:
        print("\n  claude agents --json failed.")
        pause()
        return
    here = tmux("display-message", "-p", "#{session_name}").strip()
    order = {"waiting": 0, "busy": 1}
    pane_list = panes()
    found = placed(rows, pane_list)
    found += [(p, {"status": "waiting", "name": line, "waitingFor": "start-up", "startedAt": since * 1000})
              for p, line, since in parked(pane_list, {p["id"] for p, _ in found}, time.time())[0]]
    found.sort(key=lambda pr: (order.get(pr[1].get("status"), 2), int(pr[0]["widx"] or 0), int(pr[0]["pidx"] or 0)))
    print(f"\n  {'#':<3} {'where':<22} {'session':<40} {'state':<22} up")
    for i, (p, r) in enumerate(found, 1):
        where = f"{p['wname']}.{p['pidx']}" if p["sess"] == here else f"{p['sess']}:{p['wname']}.{p['pidx']}"
        label = "NEEDS YOU" if r.get("status") == "waiting" else state(r)
        if r.get("waitingFor"):
            label += f" ({r['waitingFor']})"
        print(f"  {i:<3} {where[:22]:<22} {(r.get('name') or '?')[:40]:<40} {label[:22]:<22} {age(r.get('startedAt'))}")
    if not found:
        print("  no Claude session runs in tmux")
    bg = [f"{r.get('name') or '?'} ({r.get('state') or r.get('status') or '?'})" for r in rows if r.get("kind") == "background"]
    if bg:
        print("\n  background, see `claude agents`: " + ", ".join(bg))
    try:
        choice = input("\n  number = jump there · Enter = close  ").strip()
    except EOFError:
        return
    if choice.isdigit() and 1 <= int(choice) <= len(found):
        tmux("switch-client", *(["-c", client] if client else []), "-t", found[int(choice) - 1][0]["id"])


def help_text():
    for path in (CONFIG / "tmux-cheatsheet.md", plugin_root() / "tmux" / "cheatsheet.md"):
        if path.is_file():
            print(path.read_text())
            break
    else:
        print("cheat sheet not found; run /handoff:setup-tmux in Claude Code")
    if sys.stdin.isatty():
        pause()


def closable():
    """A dry run of the pane close: prints the panes the tick would close, closes nothing."""
    pane_list = panes()
    rows = agents()
    if rows is None:
        print("claude agents --json failed.")
        return
    found = placed(rows, pane_list)
    words = {p["id"]: tab_state(r, p.get("story")) if p.get("story") else "" for p, r in found}
    done = finished_panes(rows, found, words)
    arms = watched()
    for p, r in done:
        names = successors(p["slug"], r["sessionId"])
        watch = sorted(names & arms.get(p["slug"], set()))
        print(f"would close {p['sess']}:{p['wname']}.{p['pidx']} {p['id']} {r.get('name') or '?'}"
              f" ({'watch ' + ', '.join(watch) + ' is open' if watch else 'successor ' + ', '.join(sorted(names)) + ' runs'})")
    if not done:
        print("nothing to close")
    if setting("autoclose") != "on":
        print("autoclose is off in handoff.conf: the tick closes nothing")


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "waiting":
        status_line()
    elif cmd == "closable":
        closable()
    elif cmd == "list":
        list_sessions(argv[1] if len(argv) > 1 else "")
    elif cmd == "dialog":
        line = dialog(sys.stdin.read().splitlines())
        print(line)
        sys.exit(0 if line else 1)
    elif cmd == "help":
        help_text()
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
