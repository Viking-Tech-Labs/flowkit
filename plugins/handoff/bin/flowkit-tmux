#!/usr/bin/env python3
"""flowkit-tmux: the Claude Code sessions in tmux at a glance, for the flowkit tmux kit.

  flowkit-tmux waiting        status-bar job: marks each Claude pane with its state
                              (@flowkit_state: working, waiting, idle), each tab with how many
                              of its sessions wait on you (@flowkit_wait), each story and adhoc
                              tab with its most urgent state (@flowkit_tab), prints the total;
                              with autoclose=on in handoff.conf it also closes finished story tabs
  flowkit-tmux list [client]  numbered list of every session, waiting first; a number jumps there
  flowkit-tmux help           the cheat sheet

The kit's conf calls the copy at ~/.local/bin/flowkit-tmux, which the handoff plugin keeps at
its own version at every session start. A session is mapped to its pane through its parent
processes, up to the pane's shell; background sessions have no pane and are listed apart.
"""
import functools
import json
import os
import re
import signal
import subprocess
import sys
import time
from pathlib import Path

os.environ["PATH"] = os.pathsep.join(
    [str(Path.home() / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", "")])
SEP = "\x1f"
VERSION = re.compile(r"^\d+\.\d+\.\d+$")  # a pane running claude shows its version as the command
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "flowkit"
CLAUDE = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
URGENCY = ("needs you", "error", "stalled", "running", "watching", "done")  # a tab shows its first
STALL = 15 * 60
SESSION_LINE = re.compile(r"^Session: ([0-9a-f-]{36})\b", re.M)  # a recorded close names its session
HEADING = re.compile(r"^## (.+?) · \d{4}-\d\d-\d\d", re.M)  # a close section, or the reporter's final report
FINAL = re.compile(r"^## Final report · (\d{4}-\d\d-\d\d \d\d:\d\d)", re.M)
PROMISED = re.compile(r"^Next: (?:spawned|started) (.*)$", re.M)  # the sessions a close launched
SHELLS = {"zsh", "bash", "sh", "fish", "dash", "ksh", "tcsh"}
QUIET = 5 * 60  # a session is closed only once its transcript and forks have been still this long
BACKFILL = 15 * 60  # an unfinished story this quiet rings its reporter, who records the missing closes
GRACE = 5 * 60  # the story file sits this long after its last write before the tab goes
RING_EVERY = 5 * 60
SPAWN_GRACE = 2 * 60  # a pane flowkit-spawn stamped @flowkit_born this recently is still starting its claude


def run(*cmd):
    out = subprocess.run(cmd, capture_output=True, text=True)
    return out.stdout if out.returncode == 0 else None


def tmux(*args):
    return run("tmux", *args) or ""


def agents():
    out = run("claude", "agents", "--json")
    try:
        rows = json.loads(out) if out else None
    except ValueError:
        return None
    return rows if isinstance(rows, list) else None


def panes():
    fmt = SEP.join(["#{pane_pid}", "#{pane_id}", "#{session_name}", "#{window_id}", "#{window_index}",
                    "#{window_name}", "#{pane_index}", "#{pane_current_command}", "#{@flowkit_state}",
                    "#{@flowkit_story}#{@flowkit_adhoc}", "#{@flowkit_story}", "#{@flowkit_hold}#{@cc_hold}",
                    "#{@flowkit_rung}", "#{@flowkit_born}"])
    keys = ("pid", "id", "sess", "wid", "widx", "wname", "pidx", "cmd", "state", "story", "slug", "hold", "rung",
            "born")
    return [dict(zip(keys, line.split(SEP)))
            for line in tmux("list-panes", "-a", "-F", fmt).splitlines() if line]


def placed(rows, pane_list):
    """(pane, agent row) for every interactive session that runs inside a tmux pane."""
    parent = {}
    for line in (run("ps", "-axo", "pid=,ppid=") or "").splitlines():
        parts = line.split()
        if len(parts) == 2:
            parent[parts[0]] = parts[1]
    by_pid = {p["pid"]: p for p in pane_list}
    found = []
    for row in rows:
        if row.get("kind") != "interactive" or row.get("pid") is None:
            continue
        pid = str(row["pid"])
        for _ in range(4):
            if pid in by_pid:
                found.append((by_pid[pid], row))
                break
            pid = parent.get(pid, "")
    return found


def state(row):
    return {"busy": "working", "waiting": "waiting", "idle": "idle"}.get(row.get("status"), row.get("status") or "")


@functools.lru_cache(None)
def closed(slug):
    """Session ids with a close recorded in the story's file; the adhoc tab has no story, so all files."""
    paths = (CLAUDE / "stories").glob("*.md") if slug == "adhoc" else [CLAUDE / "stories" / f"{slug}.md"]
    ids = set()
    for path in paths:
        try:
            ids.update(SESSION_LINE.findall(path.read_text(errors="replace")))
        except OSError:
            pass
    return ids


def live(row):
    """The session's ~/.claude/sessions/<pid>.json, only if it is still this session's: pids are reused."""
    try:
        data = json.loads((CLAUDE / "sessions" / f"{row.get('pid')}.json").read_text())
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) and data.get("sessionId") == row.get("sessionId") else {}


def untouched(sid, cutoff):
    """Neither the transcript nor a fork's under <sid>/subagents/ changed after cutoff."""
    for transcript in (CLAUDE / "projects").glob(f"*/{sid}.jsonl"):
        forks = transcript.with_suffix("") / "subagents"
        for path in [transcript, forks, *(forks.glob("*") if forks.is_dir() else [])]:
            try:
                if path.stat().st_mtime > cutoff:
                    return False
            except OSError:
                pass
    return True


def tab_state(row, slug):
    """The pane's word for its tab label, or "" for none."""
    sid = row.get("sessionId") or ""
    status = row.get("status")
    if status == "waiting":
        return "needs you"
    if sid and (CLAUDE / "flowkit" / "retry" / f"{sid}.json").exists():
        return "error"
    info = live(row) if sid else {}
    if status == "busy":
        return "watching" if info.get("status") == "shell" and sid in closed(slug) else "running"
    if status != "idle" or not sid:
        return ""
    if sid in closed(slug):
        return "done"
    if (row.get("name") or "").endswith("-report"):
        return ""  # a reporter idles between closes; that is not a stall
    since = (info.get("statusUpdatedAt") or 0) / 1000
    cutoff = time.time() - STALL
    return "stalled" if since and since <= cutoff and untouched(sid, cutoff) else ""


def setting(key):
    """A key=value line of handoff.conf, the plugin's own settings; the last one wins."""
    value = ""
    try:
        for line in (CONFIG / "handoff.conf").read_text().splitlines():
            k, sep, v = line.partition("=")
            if sep and k.strip() == key:
                value = v.strip()
    except OSError:
        pass
    return value


def story_complete(text):
    """Every session a close launched has a close section of its own."""
    have = set(HEADING.findall(text)) - {"Final report"}
    want = set()
    for rest in PROMISED.findall(text):
        want.update(n.strip() for n in re.split(r",\s*", re.sub(r"\s*\(.*$", "", rest)))
    return want - {"", "none"} <= have


def story_reported(text):
    """When the reporter's final report was written, if it is newer than the last close (a story can
    go on after one), else 0."""
    last = {}
    for m in HEADING.finditer(text):
        last[m.group(1) == "Final report"] = m.start()
    if last.get(True, -1) < last.get(False, -1):
        return 0
    try:
        return time.mktime(time.strptime(FINAL.findall(text)[-1], "%Y-%m-%d %H:%M"))
    except (IndexError, ValueError):
        return 0


def ring(pane, now):
    """Wake the reporter so it writes the final report; at most once every 5 min."""
    rung = pane.get("rung") or ""
    if rung.isdigit() and now - int(rung) < RING_EVERY:
        return
    tmux("set-option", "-p", "-t", pane["id"], "@flowkit_rung", str(int(now)),
         ";", "send-keys", "-t", pane["id"], "C-u", ";", "send-keys", "-t", pane["id"], "report now", "Enter")


def starting(pane, now):
    """flowkit-spawn stamped the pane, or its tab, this recently: its claude is still coming up."""
    born = pane.get("born") or ""
    return born.isdigit() and now - int(born) < SPAWN_GRACE


def terminate(pid):
    """SIGTERM, then up to 5 s for the process to go; True once it has."""
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(10):
            time.sleep(0.5)
            os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except OSError:
        pass
    return False


def close_stories(pane_list, found, words):
    """A story whose sessions are all finished goes as a whole, its reporter last. Only tabs marked
    @flowkit_story are looked at; @flowkit_hold (or the older @cc_hold) on a tab keeps its story."""
    now = time.time()
    rows = {p["id"]: r for p, r in found}
    stories = {}
    for p in pane_list:
        if p.get("slug"):
            stories.setdefault(p["slug"], []).append(p)
    for slug, members in stories.items():
        path = CLAUDE / "stories" / f"{slug}.md"
        try:
            text, written = path.read_text(errors="replace"), path.stat().st_mtime
        except OSError:
            continue
        if any(p.get("hold") for p in members):
            continue
        if any(starting(p, now) for p in members):
            continue  # a shell flowkit-spawn just typed a launch into, before claude agents lists it
        if any(p["id"] not in rows and p["cmd"].lstrip("-") not in SHELLS for p in members):
            continue  # a pane runs something else, or a claude that claude agents does not list
        claudes = [(p, rows[p["id"]]) for p in members if p["id"] in rows]
        if any(r.get("status") != "idle" or words.get(p["id"]) == "error" for p, r in claudes):
            continue  # at work, waiting on the user, watching or in error
        report = [p for p, r in claudes if (r.get("name") or "").endswith("-report")]
        reported, complete = story_reported(text), story_complete(text)
        if not (reported or not claudes or (complete and not report)):
            if report and (complete or all(untouched(r.get("sessionId") or "", now - BACKFILL) for _, r in claudes)):
                ring(report[0], now)
            continue
        if now - written < GRACE or not all(untouched(r.get("sessionId") or "", now - QUIET) for _, r in claudes):
            continue
        if any(r.get("sessionId") not in closed(slug) and (r.get("startedAt") or now * 1000) / 1000 > reported + 60
               for p, r in claudes if p not in report):
            continue  # a session needs its own close, unless it started before a final report that covers it
        fresh = {p["id"]: p for p in panes()}  # the list is a `claude agents` old: a launch may have landed since
        if any(starting(fresh.get(p["id"], p), now) or
               (p["id"] not in rows and fresh.get(p["id"], p)["cmd"].lstrip("-") not in SHELLS) for p in members):
            continue  # stamped, or no longer a bare shell, since the list
        for p in [p for p in members if p["id"] not in rows] + [p for p, _ in claudes if p not in report] + report:
            if p["id"] in rows and not terminate(int(rows[p["id"]]["pid"])):
                break  # it would not go: the rest stay, the reporter with them
            tmux("kill-pane", "-t", p["id"])


def waiting():
    pane_list = panes()
    found = []
    if any(VERSION.match(p["cmd"]) for p in pane_list):
        rows = agents()
        if rows is None:
            return  # claude agents failed: leave the marks as they are
        found = placed(rows, pane_list)
    want = {p["id"]: state(r) for p, r in found}
    count, tab, words = {}, {}, {}
    for p, r in found:
        if r.get("status") == "waiting":
            count[p["wid"]] = count.get(p["wid"], 0) + 1
        word = words[p["id"]] = tab_state(r, p.get("story")) if p.get("story") else ""
        if word and (p["wid"] not in tab or URGENCY.index(word) < URGENCY.index(tab[p["wid"]])):
            tab[p["wid"]] = word
    cmds = []
    for p in pane_list:
        if p["id"] in want and want[p["id"]] != p["state"]:
            cmds += [";", "set-option", "-p", "-t", p["id"], "@flowkit_state", want[p["id"]]]
        elif p["id"] not in want and p["state"]:
            cmds += [";", "set-option", "-p", "-u", "-t", p["id"], "@flowkit_state"]
    for line in tmux("list-windows", "-a", "-F", SEP.join(["#{window_id}", "#{@flowkit_wait}", "#{@flowkit_tab}"])).splitlines():
        wid, have, label = (line.split(SEP) + ["", ""])[:3]
        n = count.get(wid, 0)
        if n and have != str(n):
            cmds += [";", "set-option", "-w", "-t", wid, "@flowkit_wait", str(n)]
        elif not n and have:
            cmds += [";", "set-option", "-w", "-u", "-t", wid, "@flowkit_wait"]
        word = tab.get(wid, "")
        if word and label != word:
            cmds += [";", "set-option", "-w", "-t", wid, "@flowkit_tab", word]
        elif not word and label:
            cmds += [";", "set-option", "-w", "-u", "-t", wid, "@flowkit_tab"]
    if cmds:
        tmux(*cmds[1:])
    if setting("autoclose") == "on":
        close_stories(pane_list, found, words)
    total = sum(count.values())
    if total:
        print(f"#[reverse] ⚑ {total} need{'s' if total == 1 else ''} you #[noreverse] ", end="")


def age(started_ms):
    s = int(time.time() - (started_ms or 0) / 1000)
    return f"{s // 60}m" if s < 3600 else f"{s // 3600}h" if s < 172800 else f"{s // 86400}d"


def pause():
    try:
        input("  Enter to close ")
    except EOFError:
        pass


def list_sessions(client=""):
    if "#{" in client:
        client = ""
    rows = agents()
    if rows is None:
        print("\n  claude agents --json failed.")
        pause()
        return
    here = tmux("display-message", "-p", "#{session_name}").strip()
    order = {"waiting": 0, "busy": 1}
    found = sorted(placed(rows, panes()),
                   key=lambda pr: (order.get(pr[1].get("status"), 2), int(pr[0]["widx"] or 0), int(pr[0]["pidx"] or 0)))
    print(f"\n  {'#':<3} {'where':<22} {'session':<40} {'state':<22} up")
    for i, (p, r) in enumerate(found, 1):
        where = f"{p['wname']}.{p['pidx']}" if p["sess"] == here else f"{p['sess']}:{p['wname']}.{p['pidx']}"
        label = "NEEDS YOU" if r.get("status") == "waiting" else state(r)
        if r.get("waitingFor"):
            label += f" ({r['waitingFor']})"
        print(f"  {i:<3} {where[:22]:<22} {(r.get('name') or '?')[:40]:<40} {label[:22]:<22} {age(r.get('startedAt'))}")
    if not found:
        print("  no Claude session runs in tmux")
    bg = [f"{r.get('name') or '?'} ({r.get('state') or r.get('status') or '?'})" for r in rows if r.get("kind") == "background"]
    if bg:
        print("\n  background, see `claude agents`: " + ", ".join(bg))
    try:
        choice = input("\n  number = jump there · Enter = close  ").strip()
    except EOFError:
        return
    if choice.isdigit() and 1 <= int(choice) <= len(found):
        tmux("switch-client", *(["-c", client] if client else []), "-t", found[int(choice) - 1][0]["id"])


def help_text():
    for path in (CONFIG / "tmux-cheatsheet.md", Path(__file__).resolve().parent.parent / "tmux" / "cheatsheet.md"):
        if path.is_file():
            print(path.read_text())
            break
    else:
        print("cheat sheet not found; run /handoff:setup-tmux in Claude Code")
    if sys.stdin.isatty():
        pause()


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "waiting":
        waiting()
    elif cmd == "list":
        list_sessions(argv[1] if len(argv) > 1 else "")
    elif cmd == "help":
        help_text()
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
