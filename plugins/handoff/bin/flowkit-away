#!/usr/bin/env python3
"""flowkit-away: the away and the awake flag from a shell, and the Claude Code sessions already
running when the user goes away.

  flowkit-away away|awake|back [--by <name>]         set the away flag, set the awake flag, clear
                                                     both: the handoff plugin's `handoff.py away`,
                                                     `awake` and `back`, by `shell` unless named
  flowkit-away nudge [--dry-run] [--only <name>]...  every session parked on a question gets the
                                                     away line; the others waiting are listed
  flowkit-away waiting                               one line per session waiting on the user

A session parked on a question (`claude agents --json`: status waiting, waitingFor "input
needed") is told the user is away: in a tmux pane Escape ends the question's turn and the away
line is typed as its next prompt; a background session is stopped and resumed with the line as
its prompt. A permission prompt is never answered: a script cannot approve, and must not.
Reporters (`<story>-report`) never ask and are skipped. Idle and busy sessions are left alone:
the handoff plugin's hook denies their next question while the away flag is in effect. The
session running this is busy, so it is never nudged.

The plugin runs its own copy (`handoff.py away-nudge`, which `handoff.py away` starts for the
minute its flag takes effect); `/handoff:setup-tmux` copies this file to
~/.local/bin, kept at the plugin's version at every session start, so a shell function of your
own can call `flowkit-away away`, `awake`, `back` and `nudge` too.
"""
import functools
import importlib.util
import json
import os
import subprocess
import sys
import time
from pathlib import Path

CLAUDE = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
AWAY = CLAUDE / "away"
QUESTION = "input needed"
PERMISSION = "permission prompt"
SETTLE = 10  # seconds a session may take to leave `waiting` after Escape


@functools.lru_cache(None)
def backend():
    """The plugin's backend.py, beside its handoff.py: where a session runs and how a line reaches
    it there. None without the plugin."""
    script = handoff_py()
    path = script.parent / "backend.py" if script else None
    if not (path and path.is_file()):
        return None
    spec = importlib.util.spec_from_file_location("flowkit_backend", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def agents():
    try:
        rows = backend().agents()
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return [r for r in rows if isinstance(r, dict)] if isinstance(rows, list) else None


def line():
    try:
        since = AWAY.read_text().split("\n", 1)[0].strip()
    except OSError:
        since = ""
    return (f"away{' since ' + since if since else ''}: I am off. Answer the question you asked with the "
            'recommended option, mark it "(auto)" in the decision log and in your close, carry on, and never '
            "end a turn on a question; until I am back every question is denied the same way.")


def settled(name):
    """Wait until the session called `name` is no longer waiting. True when it happened within
    SETTLE seconds."""
    deadline = time.time() + SETTLE
    while time.time() < deadline:
        row = next((r for r in (agents() or []) if r.get("name") == name), None)
        if row is None or row.get("status") != "waiting":
            return True
        time.sleep(0.5)
    return False


def reach(row, place):
    """The away line as the session's next prompt, as (typed, what claude said of a copy). In a
    tmux pane Escape ends the question's turn and the line is typed once the session has left
    waiting; a background session (no place) is stopped, then resumed under its own id with the
    line as its prompt."""
    b = backend()
    try:
        if place is None:
            why = b.BACKGROUND.type(b.Place(row.get("sessionId"), False, row), line(), b.ESCAPE)
        else:
            why = b.TMUX.type(place, line(), b.ESCAPE, settled=lambda: settled(row.get("name")))
    except (OSError, subprocess.SubprocessError, KeyError, ValueError):
        return False, ""
    said = getattr(why, "said", "").strip().splitlines()
    return not why, next((l.strip() for l in said if "copy" in l), "")


def classify(row):
    """What `nudge` does with a session, as (verb, where): nudge, permission, unreachable,
    skipped, waiting, or None when it is not waiting at all."""
    if row.get("status") != "waiting":
        return None
    name = row.get("name") or "?"
    if name.endswith("-report"):
        return "skipped", "a reporter never asks"
    what = row.get("waitingFor") or "a prompt"
    if what == PERMISSION:
        return "permission", "waits on a permission prompt; answer it from the phone"
    if what != QUESTION:
        return "waiting", f"waits on {what}"
    if row.get("kind") == "background":
        return "nudge", "background"
    return "nudge", "tmux"


def nudge(dry, only):
    rows = agents()
    if rows is None:
        print("cannot read `claude agents --json`: no session nudged")
        return 3
    try:
        find = backend().TMUX.finder()
    except (OSError, subprocess.SubprocessError):
        find = lambda pid: None  # no tmux: a question in a terminal cannot be reached
    shown = 0
    for row in rows:
        name = row.get("name") or "?"
        if only and name not in only:
            continue
        kind = classify(row)
        if kind is None:
            if only:
                print(f"{name}: not waiting ({row.get('status') or row.get('state') or '?'})")
                shown += 1
            continue
        verb, where = kind
        shown += 1
        if verb != "nudge":
            print(f"{verb} {name}: {where}")
            continue
        place = None
        if where == "tmux":
            place = find(row.get("pid"))
            if place is None:
                print(f"unreachable {name}: waits on a question outside tmux; answer it from the phone")
                continue
            where = f"tmux {place.id}"
        if dry:
            print(f"would nudge {name} ({where})")
            continue
        ok, note = reach(row, place)
        where += f"; {note}" if note else ""
        print(f"{'nudged' if ok else 'not nudged'} {name} ({where}){'' if ok else ': it did not leave the question in time'}")
    if not shown:
        print("no session waits on you")
    return 0


def waiting():
    rows = agents()
    if rows is None:
        print("cannot read `claude agents --json`")
        return 3
    found = [r for r in rows if r.get("status") == "waiting"]
    for r in found:
        print(f"{r.get('name') or '?'}: waits on {r.get('waitingFor') or 'a prompt'}")
    if not found:
        print("nobody waits on you")
    return 0


def handoff_py():
    """The handoff plugin's handoff.py: the one beside this file (the repo, the plugin cache), else
    the newest handoff in installed_plugins.json, since the copy in ~/.local/bin has nothing beside
    it. None without the plugin."""
    def version(root):
        try:
            return tuple(int(n) for n in json.loads((root / ".claude-plugin" / "plugin.json").read_text())["version"].split("."))
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            return None
    own = Path(__file__).resolve().parent.parent
    if (own / ".claude-plugin" / "plugin.json").is_file():
        return own / "scripts" / "handoff.py"
    try:
        entries = json.loads((CLAUDE / "plugins" / "installed_plugins.json").read_text())["plugins"]["handoff@flowkit"]
        roots = [Path(e["installPath"]) for e in entries]
    except (OSError, ValueError, KeyError, TypeError):
        return None
    found = [(v, root) for root in roots if (root / "scripts" / "handoff.py").is_file() and (v := version(root))]
    return max(found)[1] / "scripts" / "handoff.py" if found else None


def flag(cmd, by):
    """`away`, `awake` and `back` are the plugin's own, so a flag set from a shell is the one a
    skill sets: the last call, the nudge at its minute, who set and who cleared it."""
    script = handoff_py()
    if script is None:
        print(f"flowkit-away {cmd}: the handoff plugin is not installed (claude plugin install handoff@flowkit)",
              file=sys.stderr)
        return 3
    try:
        return subprocess.run([sys.executable, str(script), cmd, "--by", by]).returncode
    except OSError as e:
        print(f"flowkit-away {cmd}: {e}", file=sys.stderr)
        return 3


def reaching(cmd, command):
    """`nudge` and `waiting` reach the sessions through the plugin's backend.py."""
    if backend() is None:
        print(f"flowkit-away {cmd}: the handoff plugin is not installed (claude plugin install handoff@flowkit)",
              file=sys.stderr)
        return 3
    return command()


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    if cmd in ("away", "awake", "back") and (not args or (len(args) == 2 and args[0] == "--by")):
        return flag(cmd, args[1] if args else "shell")
    if cmd == "nudge":
        dry, only = False, []
        while args:
            if args[0] == "--dry-run":
                dry = True
                args = args[1:]
            elif args[0] == "--only" and len(args) > 1:
                only.append(args[1])
                args = args[2:]
            else:
                break
        if args:
            print(__doc__, file=sys.stderr)
            return 2
        return reaching(cmd, lambda: nudge(dry, only))
    if cmd == "waiting" and not args:
        return reaching(cmd, waiting)
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
