#!/usr/bin/env python3
# flowkit-spawn — start the next Claude Code session of a story with its prompt file, through
# the launch driver set in ~/.config/flowkit/handoff.conf (driver=tmux, driver=background or the
# name of an outside driver).
#
# tmux driver: one tab per story, up to 9 sessions tiled in launch order (1 top left, 2 to its
# right, …), a 10th opens <story>-2. With reporter=on, a launch that finds no `<story>-report`
# running starts one first (reporter.md next to this script's scripts/): in slot 1 of a new tab,
# else in a pane split after the last one of the session's window.
#
# background driver: `claude --bg`, Claude's own background service; no tmux needed. The session
# shows in `claude agents`, the board and Remote Control, and `claude attach <name>` opens it.
# With reporter=on, a story with no `<story>-report` session yet gets one first.
#
# an outside driver (driver=<name>): the executable flowkit-driver-<name> opens a place for the
# session in whatever it drives (docs/drivers.md). With reporter=on, a launch that finds no
# `<story>-report` running starts one first.
#
# Any driver first waits while ~/.claude/load-hold exists (see "The launch hold" below).
#
# Usage: flowkit-spawn [options] <prompt-file>
#   --repo <path>          working directory of the new session (default: the current one)
#   --name <name>          session name (default: the prompt file's name without .md)
#   --story <slug>         the story; names the tab (default: the story tab this pane is in,
#                          else the session name)
#   --model <id>           passed to claude as --model (default: none, the user's default)
#   --effort <level>       passed as --effort, as given (default: none)
#   --subagent-model <id>  the model for this session's subagents that name none
#   --permission <mode>    --permission-mode (default: permission_mode= in the conf, else none)
#   --no-rc                do not turn Remote Control on
#   --single               a one-off outside any story, in the shared adhoc tab: no reporter,
#                          no dirty-tree refusal, a taken name gets -2, the prompt is optional
#   --pane <%id>           use this pane (an idle shell) instead of the story's tab (tmux); a tab
#                          of its own with no mark becomes the story's next tab; a reporter that
#                          starts takes a pane split after the last one (slot 2 of a one-pane tab)
#   --new                  always split a new pane instead of reusing an idle shell (tmux)
#   --force                spawn even when a session of that name runs or the tree is dirty
#   --over-cap             start a new chain even when the machine's slots are all used (the gate)
#   --from-queue <id>      set by `capacity.py drain` for a queued launch: the gate already passed
#   --from-watch <arm>     set by `watch.py` for a session a watch starts (a red's fix slice, an
#                          on-green prompt): never taken for the calling session's own next slice,
#                          its story's slot back at once, the dirty-tree refusal after the gate
#   --dry-run              print the pick and the command, launch nothing
#   --tmux-socket <name>   the tmux server (tmux -L); needed when not run inside tmux
#   --tmux-session <name>  the tmux session there (default: the current one, else the first)
#   --target <word>        where to launch, in the driver's own word: what a queued launch and a
#                          watch's launch are started with, in place of the two options above
#
# Exit: 2 bad arguments · 3 no tmux to launch in (prints the command to run by hand) ·
#       4 a session of that name runs · 5 --pane is busy · 6 the repo has uncommitted changes ·
#       7 the driver is not available · 8 the folder is not trusted yet (background: run
#       `claude` there once and accept the prompt) · 9 `claude --bg` failed (its output printed) ·
#       10 claude exited twice at start-up (tmux: the launch is typed once more when the pane is
#       a bare shell again within the 15 s; its output is in the pane) · 11 queued by the gate
#       (see "The gate" below; its one line: QUEUED #<n>, ~<HH:MM> · id=<id> · <why>)
# Last lines, machine-readable (try=2 when the launch was typed a second time; parked=, to the
# line's end, only when the pane sits at a start-up prompt after the 15 s: its first line):
#   REPORTER pane=<n> id=<%id> tab=<tab> name=<slug>-report rc=<url|pending> try=<1|2> [parked=<line>]   (reporter only)
#   SPAWNED pane=<n> id=<%id> tab=<tab> story=<slug> name=<name> rc=<url|pending> prompt=<file> created=<0|1> try=<1|2> [parked=<line>]
# background driver, <id> being the id `claude attach`, `logs` and `stop` take:
#   REPORTER driver=background id=<id> name=<slug>-report rc=<url|pending>   (reporter only)
#   SPAWNED driver=background id=<id> story=<slug> name=<name> rc=<url|pending> prompt=<file>
# an outside driver, <id> being its own for the place (try=2 when a place was opened a second time):
#   REPORTER driver=<name> id=<id> name=<slug>-report rc=<url|pending> try=<1|2> [parked=<line>]   (reporter only)
#   SPAWNED driver=<name> id=<id> story=<slug> name=<name> rc=<url|pending> prompt=<file> created=1 try=<1|2> [parked=<line>]
#
# Where a session runs, and everything that is made, typed or read there, is the launch driver's:
# the plugin's scripts/backend.py answers for it, and nothing here calls tmux or Claude Code's
# background service itself.
import glob
import importlib.util
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from datetime import datetime

ME = os.path.realpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
CLAUDE = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
CONF = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "flowkit", "handoff.conf")
CAPACITY = os.path.join(ME, "scripts", "capacity.py")
ENV = dict(os.environ)  # what the gate and the watch are run with: where this launch goes is not theirs to inherit
EXITS = {"outside": 3, "nowhere": 3, "busy": 5, "untrusted": 8, "start": 9, "exited": 10}  # why a driver refused


def say(line):
    print(line, file=sys.stderr, flush=True)


def fail(code, line):
    say(line)
    sys.exit(code)


def newer():
    """The installed release answers, whichever copy was called: a session keeps the plugin
    directory it started with, and an older cache directory can sit before the newest on the
    PATH. A copy older than the one installed_plugins.json names hands over to it, once."""
    def version(root):
        with open(os.path.join(root, ".claude-plugin", "plugin.json")) as f:
            return tuple(int(n) for n in json.load(f)["version"].split("."))
    try:
        with open(os.path.join(CLAUDE, "plugins", "installed_plugins.json")) as f:
            installed = os.path.realpath(json.load(f)["plugins"]["handoff@flowkit"][0]["installPath"])
        if installed != ME and version(installed) > version(ME):
            return os.path.join(installed, "bin", "flowkit-spawn")
    except Exception:
        pass
    return ""


def backend():
    """The plugin's scripts/backend.py: the one file that reaches a session, wherever it runs."""
    spec = importlib.util.spec_from_file_location("flowkit_backend", os.path.join(ME, "scripts", "backend.py"))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def setting(key):
    """A `key=value` line of handoff.conf, its last one."""
    found = ""
    try:
        with open(CONF, errors="replace") as f:
            for line in f:
                m = re.match(rf"\s*{re.escape(key)}\s*=\s*(.*)", line.rstrip("\n"))
                if m:
                    found = m.group(1).rstrip()
    except OSError:
        pass
    return found


def slugify(text):
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower())
    slug = (slug[1:] if slug.startswith("-") else slug)[:32]
    return slug[:-1] if slug.endswith("-") else slug


def now():
    return datetime.now().strftime("%Y-%m-%d %H:%M")


def hold_info(hold):
    """(age in s, reason) of the flag, None when there is none."""
    if not os.path.isfile(hold):
        return None
    try:
        with open(hold, errors="replace") as f:
            lines = f.read().splitlines()
        at = os.stat(hold).st_mtime
    except OSError:
        return None
    try:
        at = datetime.fromisoformat(lines[0].strip().replace("Z", "+00:00")).timestamp()
    except (IndexError, ValueError):
        pass  # no readable time: the file's own
    return max(0, int(time.time() - at)), " ".join(" ".join(lines[1:]).split())[:200] or "no reason given"


def no_chrome(b):
    """A start-up prompt nobody sees (the README's "Start-up prompts"): until it has been answered
    once, Claude Code asks at a session's start whether to use Chrome by default, and a spawned pane
    sits on that question. While .claude.json holds no answer (claudeInChromeDefaultEnabled) and
    this claude knows --no-chrome (its --help, asked once per version), the launch passes the flag:
    the session starts without the question and without Chrome. chrome=on in handoff.conf leaves it
    out, and so does a .claude.json that cannot be read."""
    if setting("chrome") == "on":
        return ""
    for path in (os.path.join(CLAUDE, ".config.json"),
                 os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~"), ".claude.json")):
        try:
            with open(path) as f:
                if "claudeInChromeDefaultEnabled" in json.load(f):
                    return ""
        except FileNotFoundError:
            pass
        except Exception:
            return ""
    version = (b.claude("--version").split() or [""])[0]
    if not version[:1].isdigit():
        return ""
    seen = known = ""
    asked = os.path.join(CLAUDE, "flowkit", "no-chrome")
    try:
        with open(asked) as f:
            seen, known = (f.readline().split(None, 1) + ["", ""])[:2]
            known = known.strip()
    except OSError:
        pass
    if seen != version:
        known = "yes" if "--no-chrome" in b.claude("--help") else "no"
        try:
            os.makedirs(os.path.dirname(asked), exist_ok=True)
            with open(asked, "w") as f:
                f.write(f"{version} {known}\n")
        except OSError:
            pass
    return "--no-chrome " if known == "yes" else ""


def main(argv):
    b = backend()
    driver = b.configured()
    reporter_on, perm = setting("reporter"), setting("permission_mode")

    repo, name, story, model, effort, submodel = os.getcwd(), "", "", "", "", ""
    rc, single, pane, force_new, force, dry, prompt, over_cap, from_queue, from_watch = True, False, "", False, False, False, "", False, "", ""
    valued = {"--repo", "--name", "--story", "--model", "--effort", "--subagent-model", "--permission", "--pane",
              "--from-queue", "--from-watch", "--tmux-socket", "--tmux-session", "--target"}
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg in valued:
            if not args:
                fail(2, f"option needs a value: {arg}")
            value = args.pop(0)
            if arg == "--repo": repo = value
            elif arg == "--name": name = value
            elif arg == "--story": story = value
            elif arg == "--model": model = value
            elif arg == "--effort": effort = value
            elif arg == "--subagent-model": submodel = value
            elif arg == "--permission": perm = value
            elif arg == "--pane": pane = value
            elif arg == "--from-queue": from_queue = value
            elif arg == "--from-watch": from_watch = value
            elif arg == "--tmux-socket": os.environ["FLOWKIT_TMUX_SOCKET"] = value
            elif arg == "--tmux-session": os.environ["FLOWKIT_TMUX_SESSION"] = value
            elif arg == "--target": os.environ["FLOWKIT_TARGET"] = value
        elif arg == "--no-rc": rc = False
        elif arg == "--single": single = True
        elif arg == "--new": force_new = True
        elif arg == "--force": force = True
        elif arg == "--dry-run": dry = True
        elif arg == "--over-cap": over_cap = True
        elif arg in ("-h", "--help"):
            with open(os.path.abspath(__file__)) as f:
                for line in f.read().splitlines()[1:]:
                    if not line.startswith("#"):
                        break
                    print(line)
            return 0
        elif arg.startswith("-"):
            fail(2, f"unknown option: {arg}")
        else:
            prompt = arg

    def capacity(*more, **how):
        return subprocess.run([sys.executable, CAPACITY, *more], env=ENV, **how)

    def give_back():
        capacity("launched", "--pid", str(os.getpid()), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    # A queued launch gives back on every exit before SPAWNED, a refusal too: its entry is queued again.
    owed = [bool(from_queue)]
    try:
        return launch(b, driver, reporter_on, perm, repo, name, story, model, effort, submodel, rc, single, pane, force_new,
                      force, dry, prompt, over_cap, from_queue, from_watch, capacity, owed)
    finally:
        if owed[0]:
            give_back()


def launch(b, driver, reporter_on, perm, repo, name, story, model, effort, submodel, rc, single, pane, force_new, force, dry,
           prompt, over_cap, from_queue, from_watch, capacity, owed):
    at = b.driver(driver)
    if at is None:
        fail(7, f"launch driver '{driver}' (set in {CONF}) is not available: no executable flowkit-driver-{driver} on the PATH; "
                "use driver=tmux or driver=background, or install that driver (docs/drivers.md in the flowkit repository)")

    for v in (model, effort, submodel, perm):
        if re.search(r"[^A-Za-z0-9._\[\]-]", v):
            fail(2, f"not a model, effort or mode: '{v}'")
    if prompt or not single:
        if not (prompt and os.path.exists(prompt) and os.path.getsize(prompt) > 0):
            fail(2, f"prompt file missing or empty: '{prompt}'")
    if not os.path.isdir(repo):
        fail(2, f"repo path does not exist: {repo}")
    if prompt:
        prompt = os.path.join(os.path.realpath(os.path.dirname(prompt) or "."), os.path.basename(prompt))
    repo = os.path.realpath(repo)
    if not name:
        name = os.path.basename(prompt or repo)
        name = name[:-3] if name.endswith(".md") else name
    if not re.match(r"[A-Za-z0-9]", name):
        fail(2, f"session name must start with a letter or digit: '{name}'")
    if re.search(r"[^A-Za-z0-9._-]", name):
        fail(2, f"session name takes letters, digits, '.', '_', '-': '{name}'")

    base = ""  # what the reporter shares with the session: Remote Control and the permission mode
    if rc:
        base += "--remote-control "
    if perm:
        base += f"--permission-mode {perm} "
    flags = base
    if model:
        flags += f"--model {model} "
    if effort:
        flags += f"--effort {effort} "
    env_json = f'"CLAUDE_CODE_SUBAGENT_MODEL":"{submodel}",' if submodel else ""
    # `claude --bg` drops the caller's environment: carry the flowkit config dir, so the next session
    # reads the same handoff.conf and ladder.md.
    # It also works in place: with Claude's default worktree.bgIsolation a background session must
    # move into a worktree branch of its own before its first edit, and pushes and opens a draft PR
    # from there.
    iso = ""
    if driver == "background":
        xdg = os.environ.get("XDG_CONFIG_HOME", "")
        if xdg.startswith("/") and not re.search(r"[^A-Za-z0-9._/-]", xdg):
            env_json += f'"XDG_CONFIG_HOME":"{xdg}",'
        iso = '"worktree":{"bgIsolation":"none"}'
    settings = f'"env":{{{env_json[:-1]}}}' if env_json else ""
    settings += ("," if settings and iso else "") + iso
    if settings:
        flags += f"--settings '{{{settings}}}' "

    # Where the launch goes: named by the caller, else where this runs, else nowhere (print the command).
    try:
        target = at.target()
    except b.Refused as e:
        if e.why == "outside":
            by_hand = f' "$(cat {prompt})"' if prompt else ""
            fail(3, f"{e}; start the session by hand: cd '{repo}' && claude {flags}--name '{name}'{by_hand}")
        fail(EXITS.get(e.why, 1), str(e))
    here = at.here()

    # The story: given, else the story this pane was opened for, else the session name. A single
    # session has none: it goes with the one-offs.
    reporter = ""
    if single:
        slug = "adhoc"
    elif story:
        slug = slugify(story)
        reporter = f"{slug}-report" if reporter_on == "on" else ""
    else:
        slug = (at.story(here) if here else "") or slugify(name)
    if not slug:
        fail(2, f"story '{story}' has no letters or digits")

    def story_note(line):
        """A line appended to the story's file; a single session has none."""
        if single:
            return
        stories = os.path.join(CLAUDE, "stories")
        os.makedirs(stories, exist_ok=True)
        path = os.path.join(stories, f"{slug}.md")
        if not os.path.isfile(path):
            with open(path, "w") as f:
                f.write(f"# {slug}\n")
        with open(path, "a") as f:
            f.write(line + "\n")

    # The launch hold: a guard outside flowkit writes ~/.claude/load-hold (an ISO time, then the reason)
    # while the machine is short of memory and removes it on recovery. A launch waits for it to go,
    # checking every 30 s (FLOWKIT_HOLD_POLL), and says once, on stderr and in the story file, that it
    # is held and why. A flag older than 2 hours is stale and ignored; FLOWKIT_IGNORE_HOLD=1 skips the
    # wait. It comes before the refusals, so they look at the tree and the sessions as they are at launch.
    hold = os.path.join(CLAUDE, "load-hold")
    poll = os.environ.get("FLOWKIT_HOLD_POLL") or "30"
    held, held_at = False, int(time.time())
    while True:
        info = hold_info(hold)
        if not info:
            break
        age, why = info
        if os.environ.get("FLOWKIT_IGNORE_HOLD"):
            say(f"launch hold ignored, FLOWKIT_IGNORE_HOLD is set: {why}")
            break
        if age >= 7200:
            say(f"launch hold ignored, stale: set {age // 60} min ago ({why})")
            if not dry:
                story_note(f"> hold ignored {name} · {now()} · stale, set {age // 60} min ago · {why}")
            break
        if dry:
            say(f"launch held: {why}; a launch would wait until {hold} is gone")
            break
        if not held:
            say(f"launch held: {why}; waiting until {hold} is gone, checking every {poll} s")
            story_note(f"> held {name} · {now()} · {why}")
            held = True
        time.sleep(float(poll))
    if held:
        say(f"launch hold lifted after {(int(time.time()) - held_at) // 60} min; launching")

    # Refusal 1: the new session shares this working tree; uncommitted changes mean the session
    # spawning it has not landed its work. An untracked `.claude/` is not work: EnterWorktree keeps a
    # session's worktrees under `.claude/worktrees/`, and nothing ignores them. Run again before a
    # launch is typed a second time. A watch's launch is checked once the gate let it through:
    # into a repository's one checkout it is queued behind the slice whose changes these are.
    def clean_tree():
        if force or single:
            return
        git = ["git", "-C", repo]
        if subprocess.run([*git, "rev-parse", "--is-inside-work-tree"], capture_output=True).returncode:
            return
        status = subprocess.run([*git, "status", "--porcelain"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
        dirty = [line for line in status.stdout.splitlines() if not line.startswith("?? .claude/")][:5]
        if dirty:
            fail(6, "repo has uncommitted changes; commit them first (or --force):\n" + "\n".join(dirty))
    if not from_watch:
        clean_tree()

    # Refusal 2: a live session of that name, as `claude agents` lists it or as its place shows it
    # (Claude shows its --name in a pane's title behind a status glyph, e.g. "✳ billing-s3").
    def sessions():
        try:
            return [row for row in b.agents() if isinstance(row, dict)]
        except (OSError, ValueError, subprocess.SubprocessError):
            return []
    listed = [sessions()]

    def no_namesake(who):
        """Exit 4 when a session of that name runs; run again before a second launch is typed."""
        found = "" if force else b.running(at, who, listed[0])
        if found:
            fail(4, f"a session named '{who}' is already running ({found}); pass --force to spawn another")
    if single:
        first, n = name, 2
        while b.running(at, name, listed[0]):
            name, n = f"{first}-{n}", n + 1
    else:
        no_namesake(name)

    # The place: the driver's pick, nothing made yet. The reporter: whenever the story has none.
    asked = b.Launch(story=slug, name=name, cwd=repo, adhoc=single, rc=rc, reporter=reporter, place=pane, fresh=force_new,
                     target=target)
    try:
        plan = at.plan(asked, listed[0])
    except b.Refused as e:
        fail(EXITS.get(e.why, 1), str(e))

    # The prompt under a space-free path in the store: safe to quote, and a record of what each pane
    # was started with. A prompt already there (`handoff.py save-prompt` writes `<name>.md`) is that
    # record and is launched as it is; one from outside gets a stamped copy, which `handoff.py refresh`
    # prunes after 30 days.
    store = os.path.join(CLAUDE, "spawned")
    os.makedirs(store, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    prompt_copy = prompt_arg = copied = ""
    if prompt:
        if os.path.samefile(os.path.dirname(prompt), store):
            prompt_copy = os.path.join(store, os.path.basename(prompt))
        else:
            prompt_copy = copied = os.path.join(store, f"{name}-{stamp}.md")
            shutil.copyfile(prompt, prompt_copy)
        prompt_arg = f' "$(cat {prompt_copy})"'

    # The gate (scripts/capacity.py; the README's "Capacity"): a story launch that would open a new
    # chain while the machine's slots are all used, or while `claude agents` does not answer, is not
    # launched but queued (QUEUED, exit 11), and `capacity.py drain` starts it later with the same
    # arguments. A chain's own next slice never waits for a slot. What the prompt's `Needs:` line
    # names is taken all or none for this launch before anything waits, handed to the new session
    # after SPAWNED and given back on any other exit; a successor whose needs are not all free is
    # queued too, its closer's resources given back. A broken gate never stops a launch.
    def watch_poller():
        """An open watch with no poller gets one: a launch's end is one of the moments that is checked."""
        if glob.glob(os.path.join(CLAUDE, "flowkit", "watches", "*.json")):
            subprocess.run([sys.executable, os.path.join(ME, "scripts", "watch.py"), "ensure"], env=ENV,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if not single and not from_queue:
        again = ["--repo", repo, "--name", name, "--story", slug]
        again += ["--model", model] if model else []
        again += ["--effort", effort] if effort else []
        again += ["--subagent-model", submodel] if submodel else []
        again += ["--permission", perm] if perm else []
        again += [] if rc else ["--no-rc"]
        again += ["--new"] if force_new else []
        again += ["--force"] if force else []
        again += ["--target", target] if target else []
        again += ["--from-watch", from_watch] if from_watch else []
        again += [prompt_copy] if prompt_copy else []
        gate = ["gate", "--pid", str(os.getpid()), "--tree", repo, "--story", slug, "--name", name, "--prompt", prompt_copy]
        gate += ["--over-cap"] if over_cap else []
        gate += ["--from-watch", from_watch] if from_watch else []
        gate += ["--held", str(int(time.time()) - held_at)] if held else []
        gate += ["--dry-run"] if dry else []
        asked_gate = capacity(*gate, "--", *again, stdout=subprocess.PIPE, text=True)
        verdict, code = asked_gate.stdout.rstrip("\n"), asked_gate.returncode
        if code == 11:
            print(verdict, flush=True)
            why = verdict[len("QUEUED "):] if verdict.startswith("QUEUED ") else verdict
            story_note(f"> queued {name} · {now()} · {why}")
            watch_poller()
            return 11
        if code:
            say(f"capacity gate failed (exit {code}); launching without it")
        elif dry:
            print(f"gate:   {verdict}", flush=True)
        else:
            owed[0] = True
    if from_watch:
        clean_tree()

    # A single session shares the tree with any Claude already running in the repo: its system
    # prompt says so.
    shared_file = others = ""
    if single:
        others = ", ".join(row.get("name") or "-" for row in listed[0]
                           if (row.get("cwd") or "-") == repo or (row.get("cwd") or "-").startswith(repo + "/"))
        if others:
            shared_file = os.path.join(store, f"{name}-{stamp}-shared.md")
            with open(shared_file, "w") as f:
                f.write(f"Shared working tree: another Claude session is working in {repo} right now ({others}).\n"
                        "Do not switch branches, commit, stash, reset, rebase, pull or otherwise rewrite the working tree "
                        "unless the user says so in this session. Reading, investigating and running tests are fine.\n")
    # A prompt starting with `/` is a command (command-first): Claude Code runs it as the user's own,
    # and hands any text after it to the command as arguments, so the brief waits in the pick-up doc
    # and the system prompt says where.
    if prompt_copy:
        with open(prompt_copy, "rb") as f:
            command_first = f.read(1) == b"/"
        if command_first:
            shared_file = shared_file or os.path.join(store, f"{name}-{stamp}-brief.md")
            with open(shared_file, "a") as f:
                f.write("This session started from the slash command in its first message, run as the user's own command; "
                        "the command's arguments are only what that line carries.\n"
                        "Its slice brief (Session, Story, Chain end, Report-to, Stop when), when it has one, is the Brief: "
                        "of the WHERE TO PICK UP block in this repo's pick-up doc (grep -rl 'WHERE TO PICK UP' "
                        "--include='*.md' .). Read it before the command's first step and follow it alongside the command.\n")
    shared_arg = f' --append-system-prompt "$(cat {shared_file})"' if shared_file else ""

    chrome = no_chrome(b)
    base, flags = chrome + base, chrome + flags
    asked.args = f"{flags}--name '{name}'{shared_arg}{prompt_arg}"

    if dry:
        told = {"copy": os.path.join(ME, "bin", "flowkit-spawn") + (
                    " (the installed release, in place of the copy called)" if os.environ.get("FLOWKIT_SPAWN_REEXEC") else ""),
                "story": slug + (f" (starts {reporter} {plan.reporter})" if plan.reporter else ""),
                "repo": repo, "prompt": prompt_copy or "none", **({"shared": others} if others else {})}
        try:
            told.update(plan.show(asked))
        except b.Refused as e:
            fail(EXITS.get(e.why, 1), str(e))
        for label in ("copy", "driver", "story", "tab", "pane", "repo", "prompt", "shared", "send", "run"):
            if label in told:
                print(f"{label}:".ljust(8) + told[label])
        for path in (copied, shared_file):
            if path and os.path.exists(path):
                os.remove(path)
        return 0
    story_note(f"> launched {name} · {now()}" + (f" · launched-by: watch {from_watch}" if from_watch else ""))

    # The reporter collects the story's closes from its story file and answers "what is going on".
    if plan.reporter:
        os.makedirs(os.path.join(CLAUDE, "stories"), exist_ok=True)
        if not os.path.isfile(os.path.join(CLAUDE, "stories", f"{slug}.md")):
            with open(os.path.join(CLAUDE, "stories", f"{slug}.md"), "w") as f:
                f.write(f"# {slug}\n")
        brief = os.path.join(store, f"{reporter}-{stamp}.md")
        with open(os.path.join(ME, "scripts", "reporter.md")) as f, open(brief, "w") as out:
            out.write(f.read().replace("<slug>", slug))
        asked.reporter_args = base + (f"--settings '{{{iso}}}' " if iso else "") + f"--model sonnet --name '{reporter}' \"$(cat {brief})\""

    def again_ok(who):
        """Refusals 1 and 2, before a launch is typed a second time."""
        listed[0] = sessions()
        no_namesake(who)
        clean_tree()

    def dialog(screen):
        """The first line of the dialog a screen ends on, as `flowkit-tmux dialog` reads it."""
        try:
            return subprocess.run([os.path.join(ME, "bin", "flowkit-tmux"), "dialog"], input=screen, stdout=subprocess.PIPE,
                                  stderr=subprocess.DEVNULL, text=True).stdout.rstrip("\n")
        except OSError:
            return ""

    try:
        for opened in at.open(asked, plan, say, again_ok, dialog):
            if opened.parked:
                story_note(f"> parked {opened.name} · {now()} · {opened.parked}")
            tail = (f" try={opened.tried}" + (f" parked={opened.parked}" if opened.parked else "")) if opened.tried else ""
            if opened.name == name:
                made = f" created={opened.created}" if opened.tried else ""
                print(f"SPAWNED {opened.where} story={slug} name={name} rc={opened.rc} prompt={prompt_copy or '-'}{made}{tail}",
                      flush=True)
            else:
                print(f"REPORTER {opened.where} name={opened.name} rc={opened.rc}{tail}", flush=True)
    except b.Refused as e:
        fail(EXITS.get(e.why, 1), str(e))
    # after the SPAWNED line: the launch's resources go to the new session
    owed[0] = False
    capacity("launched", "--pid", str(os.getpid()), "--name", name, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    watch_poller()
    return 0


if __name__ == "__main__":
    handed = newer()
    if not os.environ.get("FLOWKIT_SPAWN_REEXEC") and handed and os.access(handed, os.X_OK):
        os.execve(handed, [handed, *sys.argv[1:]], {**os.environ, "FLOWKIT_SPAWN_REEXEC": "1"})
    for number, code in ((signal.SIGHUP, 129), (signal.SIGINT, 130), (signal.SIGTERM, 143)):
        signal.signal(number, lambda *_, code=code: sys.exit(code))
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, subprocess.SubprocessError) as e:
        say(f"flowkit-spawn: {e}")
        sys.exit(1)
