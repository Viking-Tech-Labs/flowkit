#!/usr/bin/env bash
# flowkit-spawn — start the next Claude Code session of a story with its prompt file, through
# the launch driver set in ~/.config/flowkit/handoff.conf (driver=tmux or driver=background).
#
# tmux driver: one tab per story, up to 9 sessions tiled in launch order (1 top left, 2 to its
# right, …), a 10th opens <story>-2. With reporter=on, a launch that finds no `<story>-report`
# running starts one first (reporter.md next to this script's scripts/): in slot 1 of a new tab,
# else in a pane split after the last one of the session's window.
#
# background driver: `claude --bg`, Claude's own background service; no tmux needed. The session
# shows in `claude agents`, the board and Remote Control, and `claude attach <name>` opens it.
# With reporter=on, a story with no `<story>-report` session yet gets one first.
#
# Usage: flowkit-spawn [options] <prompt-file>
#   --repo <path>          working directory of the new session (default: the current one)
#   --name <name>          session name (default: the prompt file's name without .md)
#   --story <slug>         the story; names the tab (default: the story tab this pane is in,
#                          else the session name)
#   --model <id>           passed to claude as --model (default: none, the user's default)
#   --effort <level>       passed as --effort, as given (default: none)
#   --subagent-model <id>  the model for this session's subagents that name none
#   --permission <mode>    --permission-mode (default: permission_mode= in the conf, else none)
#   --no-rc                do not turn Remote Control on
#   --single               a one-off outside any story, in the shared adhoc tab: no reporter,
#                          no dirty-tree refusal, a taken name gets -2, the prompt is optional
#   --pane <%id>           use this pane (an idle shell) instead of the story's tab (tmux); a tab
#                          of its own with no mark becomes the story's next tab; a reporter that
#                          starts takes a pane split after the last one (slot 2 of a one-pane tab)
#   --new                  always split a new pane instead of reusing an idle shell (tmux)
#   --force                spawn even when a session of that name runs or the tree is dirty
#   --dry-run              print the pick and the command, launch nothing
#   --tmux-socket <name>   the tmux server (tmux -L); needed when not run inside tmux
#   --tmux-session <name>  the tmux session there (default: the current one, else the first)
#
# Exit: 2 bad arguments · 3 no tmux to launch in (prints the command to run by hand) ·
#       4 a session of that name runs · 5 --pane is busy · 6 the repo has uncommitted changes ·
#       7 the driver is not available · 8 the folder is not trusted yet (background: run
#       `claude` there once and accept the prompt) · 9 `claude --bg` failed (its output printed) ·
#       10 claude exited twice at start-up (tmux: the launch is typed once more when the pane is
#       a bare shell again within the 15 s; its output is in the pane)
# Last lines, machine-readable (try=2 when the launch was typed a second time):
#   REPORTER pane=<n> id=<%id> tab=<tab> name=<slug>-report rc=<url|pending> try=<1|2>   (reporter only)
#   SPAWNED pane=<n> id=<%id> tab=<tab> story=<slug> name=<name> rc=<url|pending> prompt=<file> created=<0|1> try=<1|2>
# background driver, <id> being the id `claude attach`, `logs` and `stop` take:
#   REPORTER driver=background id=<id> name=<slug>-report rc=<url|pending>   (reporter only)
#   SPAWNED driver=background id=<id> story=<slug> name=<name> rc=<url|pending> prompt=<file>
set -euo pipefail

# The installed release answers, whichever copy was called: a session keeps the plugin
# directory it started with, and an older cache directory can sit before the newest on the
# PATH. A copy older than the one installed_plugins.json names hands over to it, once.
me="$(cd "$(dirname "$0")/.." && pwd -P)"
newer="$(python3 - "$me" <<'EOF' 2>/dev/null || true
import json, os, sys
own = sys.argv[1]
conf = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude")
def version(root):
    with open(os.path.join(root, ".claude-plugin", "plugin.json")) as f:
        return tuple(int(n) for n in json.load(f)["version"].split("."))
try:
    with open(os.path.join(conf, "plugins", "installed_plugins.json")) as f:
        installed = os.path.realpath(json.load(f)["plugins"]["handoff@flowkit"][0]["installPath"])
    if installed != own and version(installed) > version(own):
        print(installed)
except Exception:
    pass
EOF
)"
if [ -z "${FLOWKIT_SPAWN_REEXEC:-}" ] && [ -n "$newer" ] && [ -x "$newer/bin/flowkit-spawn" ]; then
  FLOWKIT_SPAWN_REEXEC=1 exec "$newer/bin/flowkit-spawn" "$@"
fi
copy="$me/bin/flowkit-spawn${FLOWKIT_SPAWN_REEXEC:+ (the installed release, in place of the copy called)}"

conf="${XDG_CONFIG_HOME:-$HOME/.config}/flowkit/handoff.conf"
setting() { [ -f "$conf" ] && sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$conf" | tail -1 | sed 's/[[:space:]]*$//'; }
driver="$(setting driver || true)"; driver="${driver:-tmux}"
reporter_on="$(setting reporter || true)"
perm="$(setting permission_mode || true)"

repo="$PWD"; name=""; story=""; model=""; effort=""; submodel=""
rc=1; single=0; pane=""; force_new=0; force=0; dry=0; prompt=""
socket="${FLOWKIT_TMUX_SOCKET:-}"; sess="${FLOWKIT_TMUX_SESSION:-}"
while [ $# -gt 0 ]; do
  case "$1" in
    --repo) repo="$2"; shift 2 ;;
    --name) name="$2"; shift 2 ;;
    --story) story="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --effort) effort="$2"; shift 2 ;;
    --subagent-model) submodel="$2"; shift 2 ;;
    --permission) perm="$2"; shift 2 ;;
    --no-rc) rc=0; shift ;;
    --single) single=1; shift ;;
    --pane) pane="$2"; shift 2 ;;
    --new) force_new=1; shift ;;
    --force) force=1; shift ;;
    --dry-run) dry=1; shift ;;
    --tmux-socket) socket="$2"; shift 2 ;;
    --tmux-session) sess="$2"; shift 2 ;;
    -h|--help) sed -n '2,46p' "$0"; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) prompt="$1"; shift ;;
  esac
done

case "$driver" in
  tmux|background) ;;
  *) echo "launch driver '$driver' (set in $conf) is not available in this version; use driver=tmux or driver=background" >&2; exit 7 ;;
esac

for v in "$model" "$effort" "$submodel" "$perm"; do
  case "$v" in *[!A-Za-z0-9._\[\]-]*) echo "not a model, effort or mode: '$v'" >&2; exit 2 ;; esac
done
if [ -n "$prompt" ] || [ "$single" -eq 0 ]; then
  [ -n "$prompt" ] && [ -s "$prompt" ] || { echo "prompt file missing or empty: '$prompt'" >&2; exit 2; }
fi
[ -d "$repo" ] || { echo "repo path does not exist: $repo" >&2; exit 2; }
[ -z "$prompt" ] || prompt="$(cd "$(dirname "$prompt")" && pwd -P)/$(basename "$prompt")"
repo="$(cd "$repo" && pwd -P)"
[ -n "$name" ] || { name="$(basename "${prompt:-$repo}")"; name="${name%.md}"; }
case "$name" in [A-Za-z0-9]*) ;; *) echo "session name must start with a letter or digit: '$name'" >&2; exit 2 ;; esac
case "$name" in *[!A-Za-z0-9._-]*) echo "session name takes letters, digits, '.', '_', '-': '$name'" >&2; exit 2 ;; esac

base="" # what the reporter shares with the session: Remote Control and the permission mode
[ "$rc" -eq 1 ] && base+="--remote-control "
[ -n "$perm" ] && base+="--permission-mode $perm "
flags="$base"
[ -n "$model" ] && flags+="--model $model "
[ -n "$effort" ] && flags+="--effort $effort "
env_json=""
[ -n "$submodel" ] && env_json+="\"CLAUDE_CODE_SUBAGENT_MODEL\":\"$submodel\","
# `claude --bg` drops the caller's environment: carry the flowkit config dir, so the next session
# reads the same handoff.conf and ladder.md.
# It also works in place: with Claude's default worktree.bgIsolation a background session must
# move into a worktree branch of its own before its first edit, and pushes and opens a draft PR
# from there.
iso=""
if [ "$driver" = background ]; then
  case "${XDG_CONFIG_HOME:-}" in /*[!A-Za-z0-9._/-]*|"") ;; /*) env_json+="\"XDG_CONFIG_HOME\":\"$XDG_CONFIG_HOME\"," ;; esac
  iso='"worktree":{"bgIsolation":"none"}'
fi
settings="${env_json:+\"env\":{${env_json%,}\}}"
settings="$settings${settings:+${iso:+,}}$iso"
[ -n "$settings" ] && flags+="--settings '{$settings}' "

# Which tmux: an explicit server, else the one this runs inside, else none (print the command).
tm() { if [ -n "$socket" ]; then tmux -L "$socket" "$@"; else tmux "$@"; fi; }
here="${TMUX_PANE:-}"
if [ "$driver" = background ]; then here=""
elif [ -z "$socket" ] && [ -z "${TMUX:-}" ]; then
  echo "not inside tmux; start the session by hand: cd '$repo' && claude ${flags}--name '$name'${prompt:+ \"\$(cat $prompt)\"}" >&2
  exit 3
fi
if [ "$driver" = tmux ]; then
  # A pane of another server is not "here": pane ids repeat across servers.
  [ -n "$socket" ] && [ "$(basename "${TMUX:-x}" | cut -d, -f1)" != "$socket" ] && here=""
  if [ -z "$sess" ]; then
    if [ -n "$here" ]; then sess="$(tm display-message -p -t "$here" '#{session_name}')"
    else sess="$(tm list-sessions -F '#{session_name}' 2>/dev/null | head -1 || true)"; fi
  fi
  [ -n "$sess" ] || { echo "no tmux session to launch in${socket:+ on server '$socket'}" >&2; exit 3; }
fi

is_shell() { case "$1" in zsh|bash|fish|sh|-zsh|-bash|-fish|-sh) return 0 ;; *) return 1 ;; esac; }
slugify() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9][^a-z0-9]*/-/g' -e 's/^-//' | cut -c1-32 | sed -e 's/-$//'; }

# The story: given, else the story tab this pane is in, else the session name. A single session
# has none: its tabs are marked @flowkit_adhoc instead of @flowkit_story.
key="@flowkit_story"; reporter=0
if [ "$single" -eq 1 ]; then slug="adhoc"; key="@flowkit_adhoc"
elif [ -n "$story" ]; then slug="$(slugify "$story")"; [ "$reporter_on" = "on" ] && reporter=1
else
  slug="$([ -n "$here" ] && tm show-options -wqv -t "$here" @flowkit_story || true)"
  [ -n "$slug" ] || slug="$(slugify "$name")"
fi
[ -n "$slug" ] || { echo "story '$story' has no letters or digits" >&2; exit 2; }

# Refusal 1: the new session shares this working tree; uncommitted changes mean the session
# spawning it has not landed its work. An untracked `.claude/` is not work: EnterWorktree keeps a
# session's worktrees under `.claude/worktrees/`, and nothing ignores them. Run again before a
# launch is typed a second time (start).
clean_tree() {
  local dirty
  [ "$force" -eq 0 ] && [ "$single" -eq 0 ] && git -C "$repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  dirty="$(git -C "$repo" status --porcelain 2>/dev/null | grep -v '^?? \.claude/' | head -5 || true)"
  if [ -n "$dirty" ]; then
    printf 'repo has uncommitted changes; commit them first (or --force):\n%s\n' "$dirty" >&2
    exit 6
  fi
}
clean_tree

# Refusal 2: a live session of that name, as `claude agents` lists it or as a pane title
# (Claude shows its --name there behind a status glyph, e.g. "✳ billing-s3").
# `claude agents --json` as one "<pid> <name> <cwd>" line per live session (python3, no jq).
sessions() {
  claude agents --json 2>/dev/null | python3 -c 'import json, sys
for r in json.load(sys.stdin):
    print(r.get("pid") or "-", r.get("name") or "-", r.get("cwd") or "-")' 2>/dev/null || true
}
agents="$(sessions)"
running() {
  local pid pcmd ptitle
  if printf '%s\n' "$agents" | awk -v n="$1" '$2 == n { f = 1 } END { exit !f }'; then
    echo "claude agents"; return 0
  fi
  [ "$driver" = tmux ] || return 1
  while IFS=' ' read -r pid pcmd ptitle; do
    ptitle="${ptitle#"${ptitle%%[[:alnum:]]*}"}"
    if [ "$pid" != "$here" ] && ! is_shell "$pcmd" && [ "$ptitle" = "$1" ]; then echo "$pid"; return 0; fi
  done < <(tm list-panes -a -F '#{pane_id} #{pane_current_command} #{pane_title}')
  return 1
}
no_namesake() { # name: exit 4 when a session of that name runs; run again before a second launch is typed
  local found
  if [ "$force" -eq 0 ] && found="$(running "$1")"; then
    echo "a session named '$1' is already running ($found); pass --force to spawn another" >&2
    exit 4
  fi
}
if [ "$single" -eq 1 ]; then
  base="$name"; n=2
  while running "$name" >/dev/null; do name="$base-$n"; n=$((n + 1)); done
else no_namesake "$name"; fi

idle_pane() { # first idle shell pane of a window that is not this pane
  local pid pcmd pdead pmode
  while IFS=' ' read -r pid pcmd pdead pmode; do
    if [ "$pid" != "$here" ] && [ "$pdead" = "0" ] && [ "$pmode" = "0" ] && is_shell "$pcmd"; then
      echo "$pid"; return 0
    fi
  done < <(tm list-panes -t "$1" -F '#{pane_id} #{pane_current_command} #{pane_dead} #{pane_in_mode}')
  return 1
}
split_after_last() { # a new pane after the window's last one, so tiling keeps launch order
  local last; last="$(tm list-panes -t "$1" -F '#{pane_id}' | tail -1)"
  tm split-window -d -t "$last" -c "$repo" -P -F '#{pane_id}'
  tm select-layout -t "$1" tiled >/dev/null
}

# The pane: given; else an idle shell or a free slot in the story's tabs (part order); else a
# new tab <slug>[-<part>] after the last tab.
created=0; win=""; new_tab=""; rpane=""; part=1; claim=""
if [ "$driver" = background ]; then :
elif [ -n "$pane" ]; then
  pcmd="$(tm display-message -p -t "$pane" '#{pane_current_command}')"
  is_shell "$pcmd" || { echo "pane $pane is running '$pcmd', not an idle shell" >&2; exit 5; }
  # A tab opened by hand for this one pane becomes the story's next tab: the closer may close it
  # once the story is finished, and the story's next launch finds it. A tab with other panes in
  # it stays yours: the closer closes whole tabs.
  read -r win npanes marked <<<"$(tm display-message -p -t "$pane" '#{window_id} #{window_panes} #{@flowkit_story}#{@flowkit_adhoc}')"
  if [ "$single" -eq 0 ] && [ "$npanes" -eq 1 ] && [ -z "$marked" ]; then
    parts="$(tm list-windows -t "$sess" -F "#{${key}_part} #{${key}}" | awk -v s="$slug" '$2 == s { print $1 }' | sort -n | tail -1)"
    part=$(( ${parts:-0} + 1 )); claim="$win"
  fi
else
  parts=0
  while IFS=' ' read -r p wid npanes; do
    parts="$p"
    [ -z "$pane" ] || continue
    if [ "$force_new" -eq 0 ] && ip="$(idle_pane "$wid")"; then pane="$ip"; win="$wid"
    elif [ "$npanes" -lt 9 ]; then win="$wid"; pane="new"; fi
  done < <(tm list-windows -t "$sess" -F "#{${key}_part} #{window_id} #{window_panes} #{${key}}" \
    | awk -v s="$slug" '$4 == s { print $1, $2, $3 }' | sort -n)
  if [ -z "$pane" ]; then
    part=$((parts + 1)); new_tab="$slug"; [ "$part" -gt 1 ] && new_tab="$slug-$part"
    pane="new"
  fi
fi
# The reporter: whenever the story has none running, not only on its first tab (a chain whose
# reporter died ran nine slices unreported). Slot 1 of a new tab, else a pane after the last.
[ "$driver" != background ] && [ "$reporter" -eq 1 ] && ! running "$slug-report" >/dev/null && rpane="new"

# The prompt under a space-free path in the store: safe to quote, and a record of what each pane
# was started with. A prompt already there (`handoff.py save-prompt` writes `<name>.md`) is that
# record and is launched as it is; one from outside gets a stamped copy, which `handoff.py refresh`
# prunes after 30 days.
store="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/spawned"; mkdir -p "$store"
stamp="$(date +%Y%m%d-%H%M%S)"
prompt_copy=""; prompt_arg=""; copied=""
if [ -n "$prompt" ]; then
  if [ "$(dirname "$prompt")" -ef "$store" ]; then prompt_copy="$store/$(basename "$prompt")"
  else prompt_copy="$store/${name}-${stamp}.md"; cp "$prompt" "$prompt_copy"; copied="$prompt_copy"; fi
  prompt_arg=" \"\$(cat $prompt_copy)\""
fi

# A single session shares the tree with any Claude already running in the repo: its system
# prompt says so.
shared_arg=""; shared_file=""
if [ "$single" -eq 1 ]; then
  others="$(printf '%s\n' "$agents" | awk -v r="$repo" '{ c = substr($0, length($1 $2) + 3) }
    c == r || index(c, r "/") == 1 { printf "%s%s", (n++ ? ", " : ""), $2 }')"
  if [ -n "$others" ]; then
    shared_file="$store/${name}-${stamp}-shared.md"
    printf '%s\n' "Shared working tree: another Claude session is working in $repo right now ($others)." \
      "Do not switch branches, commit, stash, reset, rebase, pull or otherwise rewrite the working tree unless the user says so in this session. Reading, investigating and running tests are fine." > "$shared_file"
  fi
fi
# A prompt starting with `/` is a command (command-first): Claude Code runs it as the user's own,
# and hands any text after it to the command as arguments, so the brief waits in the pick-up doc
# and the system prompt says where.
if [ -n "$prompt_copy" ] && [ "$(head -c 1 "$prompt_copy")" = / ]; then
  [ -n "$shared_file" ] || shared_file="$store/${name}-${stamp}-brief.md"
  printf '%s\n' "This session started from the slash command in its first message, run as the user's own command; the command's arguments are only what that line carries." \
    "Its slice brief (Session, Story, Chain end, Report-to, Stop when), when it has one, is the Brief: of the WHERE TO PICK UP block in this repo's pick-up doc (grep -rl 'WHERE TO PICK UP' --include='*.md' .). Read it before the command's first step and follow it alongside the command." >> "$shared_file"
fi
[ -z "$shared_file" ] || shared_arg=" --append-system-prompt \"\$(cat $shared_file)\""

launch="clear; claude ${flags}--name '$name'${shared_arg}${prompt_arg}"

# Background driver: `claude --bg` hands the session to Claude's background service and returns
# its id. It refuses at once in a folder never trusted; it never waits at the prompt.
if [ "$driver" = background ]; then
  bg_id=""; bg_rc=""
  listed() { # field value [--all]: does `claude agents --json` list a session with that field?
    claude agents --json ${3:-} 2>/dev/null | python3 -c 'import json, sys
sys.exit(0 if any(a.get(sys.argv[1]) == sys.argv[2] for a in json.load(sys.stdin)) else 1)' "$1" "$2" 2>/dev/null
  }
  bg_start() { # command session-name: sets bg_id and bg_rc, or exits 8 or 9
    local out
    if ! out="$(cd "$repo" && eval "claude --bg $1" 2>&1)"; then
      case "$out" in *"not trusted"*) printf '%s\n' "$out" >&2; exit 8 ;; esac
      printf 'claude --bg failed:\n%s\n' "$out" >&2; exit 9
    fi
    bg_id="$(printf '%s\n' "$out" | sed -n 's/^backgrounded · \([0-9a-f]*\).*/\1/p' | head -1)"
    [ -n "$bg_id" ] || { printf 'claude --bg printed no session id:\n%s\n' "$out" >&2; exit 9; }
    # Confirmed when `claude agents` lists it; the Remote Control link shows in its log.
    local up=0
    for _ in $(seq 1 15); do
      listed id "$bg_id" && { up=1; break; }
      sleep 1
    done
    [ "$up" -eq 1 ] || echo "warning: background session '$2' ($bg_id) is not listed by claude agents after 15s; check claude logs $bg_id" >&2
    bg_rc=off
    if [ "$rc" -eq 1 ]; then
      bg_rc=pending
      for _ in $(seq 1 30); do
        url="$(claude logs "$bg_id" 2>/dev/null | grep -o 'https://claude.ai/code/session_[A-Za-z0-9]*' | head -1 || true)"
        [ -n "$url" ] && { bg_rc="$url"; break; }
        sleep 1
      done
    fi
  }
  # The reporter: one per story, kept between closes. A stopped one is woken by the next ring
  # (handoff.py), so only a story that never had one gets a new one.
  start_reporter=0
  [ "$reporter" -eq 1 ] && ! listed name "$slug-report" --all && start_reporter=1
  if [ "$dry" -eq 1 ]; then
    echo "copy:   $copy"
    echo "driver: background"
    echo "story:  $slug$([ "$start_reporter" -eq 1 ] && echo " (starts $slug-report first)")"
    echo "repo:   $repo"
    echo "prompt: ${prompt_copy:-none}"
    [ -n "${others:-}" ] && echo "shared: $others"
    echo "run:    cd '$repo' && claude --bg ${flags}--name '$name'${shared_arg}${prompt_arg}"
    [ -z "$copied" ] || rm -f "$copied"; [ -z "$shared_file" ] || rm -f "$shared_file"
    exit 0
  fi
  if [ "$start_reporter" -eq 1 ]; then
    stories="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/stories"; mkdir -p "$stories"
    [ -f "$stories/$slug.md" ] || printf '# %s\n' "$slug" > "$stories/$slug.md"
    rprompt="$store/${slug}-report-${stamp}.md"
    sed -e "s/<slug>/$slug/g" "$(dirname "$0")/../scripts/reporter.md" > "$rprompt"
    bg_start "${base}--settings '{$iso}' --model sonnet --name '$slug-report' \"\$(cat $rprompt)\"" "$slug-report"
    echo "REPORTER driver=background id=$bg_id name=$slug-report rc=$bg_rc"
  fi
  bg_start "${flags}--name '$name'${shared_arg}${prompt_arg}" "$name"
  echo "SPAWNED driver=background id=$bg_id story=$slug name=$name rc=$bg_rc prompt=${prompt_copy:--}"
  exit 0
fi

if [ "$dry" -eq 1 ]; then
  echo "copy:   $copy"
  rwhere="in slot 1"; [ -n "$new_tab" ] || rwhere="in a pane after the last"
  echo "story:  $slug${rpane:+ (starts $slug-report $rwhere)}"
  echo "tab:    ${new_tab:+new tab $new_tab after the last one}${win:+$(tm display-message -p -t "$win" '#{window_name}')}${claim:+ (becomes tab $part of the story)}"
  echo "pane:   ${pane/#new/<new, tiled after the last pane>}"
  echo "repo:   $repo"
  echo "prompt: ${prompt_copy:-none}"
  [ -n "${others:-}" ] && echo "shared: $others"
  echo "send:   cd '$repo' && $launch"
  [ -z "$copied" ] || rm -f "$copied"; [ -z "$shared_file" ] || rm -f "$shared_file"
  exit 0
fi

# Marks a window as the story's tab. The @flowkit_born stamp comes first, in the same command: the
# story closer (flowkit-tmux waiting) runs at every status-line redraw, and opening a window is
# one, so it lists the panes within milliseconds and must never see a story tab of bare shells
# without a stamp. Each pane's top border names its slot, its session and the state the tick sets.
mark_tab() { # window
  tm set-option -w -t "$1" @flowkit_born "$(date +%s)" \
    \; set-option -w -t "$1" "$key" "$slug" \; set-option -w -t "$1" "${key}_part" "$part" \
    \; set-option -w -t "$1" pane-border-status top \
    \; set-option -w -t "$1" pane-border-format \
    ' #{pane_index} #{s/^[^a-zA-Z0-9]+//:pane_title}#{?#{@flowkit_state}, · #{?#{==:#{@flowkit_state},waiting},#[reverse] NEEDS YOU #[noreverse],#{@flowkit_state}},} '
}
if [ -n "$new_tab" ]; then
  idx=$(( $(tm list-windows -t "$sess" -F '#{window_index}' | sort -n | tail -1) + 1 ))
  win="$(tm new-window -d -t "$sess:$idx" -n "$new_tab" -c "$repo" -P -F '#{window_id}')"
  mark_tab "$win"
  first="$(tm list-panes -t "$win" -F '#{pane_id}' | head -1)"
  if [ "$rpane" = "new" ]; then rpane="$first"; pane="$(split_after_last "$win")"
  else pane="$first"; fi
  created=1
elif [ "$pane" = "new" ]; then
  [ "$rpane" = "new" ] && rpane="$(split_after_last "$win")"
  pane="$(split_after_last "$win")"
  created=1
else
  [ -n "$claim" ] && mark_tab "$claim"
  [ "$rpane" = "new" ] && rpane="$(split_after_last "$win")"
fi

# Types the launch into a pane, then waits up to 15 s until `claude agents` lists a session of
# that name under the pane's shell and Remote Control has printed its link, 30 s more for the
# link alone. Sets rcurl to the link, "pending" or "off", and try to 1 or 2: a pane that is a
# bare shell again within the 15 s with no session of the name listed means claude exited at
# start-up, so the launch is typed once more into that pane, after refusals 1 and 2 pass again;
# a second exit is exit 10, the output left in the pane. A pane still running something unlisted
# at 15 s (a prompt, a slow start) gets the warning, never a second launch. Never types
# /remote-control: with the flag passed that opens the Remote Control panel, which holds back
# background-task results while open.
type_launch() { # pane command
  tm set-option -p -t "$1" @flowkit_born "$(date +%s)" # the story closer leaves a starting pane alone
  tm send-keys -t "$1" C-u # anything half-typed would prefix the command
  tm send-keys -t "$1" "cd '$repo' && $2" Enter
}
start() { # pane command session-name
  local up=0 seen=0 i=0 screen shell_pid pid pcmd
  shell_pid="$(tm display-message -p -t "$1" '#{pane_pid}')"
  rcurl=""; try=1
  type_launch "$1" "$2"
  while [ "$i" -lt 15 ]; do
    i=$((i + 1)); sleep 1
    screen="$(tm capture-pane -p -J -S -80 -t "$1" 2>/dev/null || true)"
    for pid in $(sessions | awk -v n="$3" '$2 == n && $1 != "-" { print $1 }'); do
      [ "$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')" = "$shell_pid" ] && up=1
    done
    rcurl="$(printf '%s' "$screen" | grep -o 'https://claude.ai/code/session_[A-Za-z0-9]*' | head -1 || true)"
    [ "$up" -eq 1 ] && { [ "$rc" -eq 0 ] || [ -n "$rcurl" ]; } && break
    [ "$up" -eq 0 ] || continue
    # The shell again, once claude was seen running or from the third second on (right after
    # Enter the pane can still read as the shell), and the launch no longer on the screen (a
    # shell slow to start has it typed ahead, unread; `clear` wipes it once it runs).
    pcmd="$(tm display-message -p -t "$1" '#{pane_current_command}')"
    if ! is_shell "$pcmd"; then seen=1; continue; fi
    { [ "$seen" -eq 1 ] || [ "$i" -ge 3 ]; } || continue
    tm capture-pane -p -J -t "$1" 2>/dev/null | grep -qF -- "--name '$3'" && continue
    if [ "$try" -eq 2 ]; then
      echo "session '$3' exited twice at start-up in pane $1; its output is in the pane" >&2
      exit 10
    fi
    agents="$(sessions)"; no_namesake "$3"; clean_tree
    echo "warning: session '$3' exited at start-up in $1; typed again" >&2
    try=2; i=0; seen=0
    type_launch "$1" "$2"
  done
  if [ "$up" -eq 1 ] && [ "$rc" -eq 1 ] && [ -z "$rcurl" ]; then
    for _ in $(seq 1 30); do
      sleep 1
      rcurl="$(tm capture-pane -p -J -S -80 -t "$1" 2>/dev/null | grep -o 'https://claude.ai/code/session_[A-Za-z0-9]*' | head -1 || true)"
      [ -n "$rcurl" ] && break
    done
  fi
  [ "$up" -eq 1 ] || echo "warning: no session '$3' came up in $1 within 15s; check the pane (a folder trust prompt?)" >&2
  if [ "$rc" -eq 0 ]; then rcurl=off; else rcurl="${rcurl:-pending}"; fi
}

# The reporter collects the story's closes from its story file and answers "what is going on".
# Its line is printed before the session starts: an exit 10 there still says a reporter runs.
tab="$(tm display-message -p -t "$pane" '#{window_name}')"
if [ -n "$rpane" ]; then
  stories="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/stories"; mkdir -p "$stories"
  [ -f "$stories/$slug.md" ] || printf '# %s\n' "$slug" > "$stories/$slug.md"
  rprompt="$store/${slug}-report-${stamp}.md"
  sed -e "s/<slug>/$slug/g" "$(dirname "$0")/../scripts/reporter.md" > "$rprompt"
  start "$rpane" "clear; claude ${base}--model sonnet --name '$slug-report' \"\$(cat $rprompt)\"" "$slug-report"
  echo "REPORTER pane=$(tm display-message -p -t "$rpane" '#{pane_index}') id=$rpane tab=$tab name=$slug-report rc=$rcurl try=$try"
fi
start "$pane" "$launch" "$name"
echo "SPAWNED pane=$(tm display-message -p -t "$pane" '#{pane_index}') id=$pane tab=$tab story=$slug name=$name rc=$rcurl prompt=${prompt_copy:--} created=$created try=$try"
