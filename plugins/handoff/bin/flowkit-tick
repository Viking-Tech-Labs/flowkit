#!/usr/bin/env python3
"""flowkit-tick: the tick of the handoff plugin, the work that goes on while nobody types.

  flowkit-tick [--timer]  one pass now. Each job runs on its own, so one that fails, or whose
                          program is missing, stops no other:
                            - drains the capacity queue (`capacity.py drain`);
                            - stops a resource left free for its minutes (`capacity.py idle`);
                            - starts again the watch poller that went (`watch.py run`);
                            - starts again the waiter of a session stopped on a usage limit;
                            - when the account of a login changes, brings Remote Control back to
                              the sessions that lost it (`handoff.py reconnect`);
                            - with remind=on in handoff.conf, sends the reminders
                              (`handoff.py remind`);
                            - where tmux is installed, has `flowkit-tmux marks` mark the panes
                              and tabs and close what autoclose=on lets it close, and keeps the
                              status line it prints.
                          --timer is what the timer passes (the LaunchAgent `/handoff:setup`
                          installs runs this every 15 seconds): the pass is stamped as a timer's
  flowkit-tick bar        the tmux status bar's job: prints the status line the last pass kept.
                          Where no timer keeps the tick (no timed pass in the last minute: Linux,
                          or the timer not installed), a pass runs first once that line is 10
                          seconds old, as it did before there was a timer
  flowkit-tick status     who keeps the tick, when its last pass ran and what failed in it;
                          exit 1 when no pass ran in the last minute

The tick's lock and what it keeps live in ~/.claude/flowkit/ (tick.lock, tick.json), never in the
temp folder: a timer and a status bar do not always share one. The copy at ~/.local/bin/flowkit-tick
is what a tmux.conf and the timer call; the handoff plugin moves it forward to its own version at
every session start, and it finds the plugin's other files through installed_plugins.json.
"""
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

os.environ["PATH"] = os.pathsep.join(
    [str(Path.home() / ".local/bin"), "/opt/homebrew/bin", "/usr/local/bin", os.environ.get("PATH", "")])
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "flowkit"
CLAUDE = Path(os.environ.get("CLAUDE_CONFIG_DIR") or Path.home() / ".claude")
CACHE = CLAUDE / "flowkit" / "tick.json"  # the last pass: when, its status line, a timer's stamp, what failed
FRESH = 10  # a status line this young is printed again without a pass
TIMED = 60  # a timed pass this young: a timer keeps the tick, and the status bar only prints
MARKS_WAIT = 120  # seconds `flowkit-tmux marks` has; closing a finished story takes up to 5 s a pane
LOOK = 3 * 60  # after the account of a login changed, every session is looked at again this long: its notice may come late


def setting(key):
    """A key=value line of handoff.conf, the plugin's own settings; the last one wins."""
    value = ""
    try:
        for line in (CONFIG / "handoff.conf").read_text().splitlines():
            k, sep, v = line.partition("=")
            if sep and k.strip() == key:
                value = v.strip()
    except OSError:
        pass
    return value


def plugin_root():
    """The handoff plugin whose files this copy uses: its own when they sit beside it (the repo, the
    plugin cache), else the newest handoff in installed_plugins.json, since the copy in
    ~/.local/bin has nothing beside it."""
    own = Path(__file__).resolve().parent.parent
    if (own / ".claude-plugin" / "plugin.json").is_file():
        return own
    def version(root):
        try:
            return tuple(int(n) for n in json.loads((root / ".claude-plugin" / "plugin.json").read_text())["version"].split("."))
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            return None
    try:
        entries = json.loads((CLAUDE / "plugins" / "installed_plugins.json").read_text())["plugins"]["handoff@flowkit"]
        roots = [Path(e["installPath"]) for e in entries]
    except (OSError, ValueError, KeyError, TypeError):
        return own
    found = [(v, root) for root in roots if (root / "scripts" / "capacity.py").is_file() and (v := version(root))]
    return max(found)[1] if found else own


def drain():
    """The capacity queue drains on the tick too, so a slot freed by a session that died or sat
    idle starts the next queued launch. An empty queue costs one directory read; else
    `capacity.py drain` runs detached, at most every FLOWKIT_CAPACITY_POLL (15) seconds."""
    state = CLAUDE / "capacity"
    try:
        if not any(e.name.endswith(".json") for e in os.scandir(state / "queue")):
            return
    except OSError:
        return
    try:
        if time.time() - (state / ".tick").stat().st_mtime < float(os.environ.get("FLOWKIT_CAPACITY_POLL") or 15):
            return
    except OSError:
        pass
    try:
        (state / ".tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "capacity.py"), "drain"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def idle():
    """A resource with a `stop` line in capacity.conf is stopped once it sat free for its minutes
    (the README's "A free resource is stopped"): while the file has such a line, `capacity.py idle`
    runs detached at most once a minute, and returns at once itself when no such resource is
    leased or counting. Without one this costs one file read."""
    try:
        if not re.search(r"^\s*stop\s+\S+\s*=", (CONFIG / "capacity.conf").read_text(), re.M):
            return
    except OSError:
        return
    state = CLAUDE / "capacity"
    try:
        if time.time() - (state / ".idle").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        state.mkdir(parents=True, exist_ok=True)
        (state / ".idle").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "capacity.py"), "idle"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def watch():
    """An open watch needs its poller (scripts/watch.py): when its process is gone or its heartbeat,
    poller.pid's mtime, is older than three minutes, `watch.py run` starts detached, at most once a
    minute; a poller that still runs makes that one exit. No watch costs one directory read."""
    state = CLAUDE / "flowkit" / "watches"
    try:
        if not any(e.name.endswith(".json") for e in os.scandir(state)):
            return
    except OSError:
        return
    try:
        os.kill(int((state / "poller.pid").read_text()), 0)
        if time.time() - (state / "poller.pid").stat().st_mtime < 180:
            return
    except (OSError, ValueError):
        pass
    try:
        if time.time() - (state / ".tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        (state / ".tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "watch.py"), "run"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def account(path):
    """The account and organization ids an account file names, or None."""
    try:
        who = json.loads(path.read_text()).get("oauthAccount")
    except (OSError, ValueError, AttributeError):
        return None
    return {"account": who["accountUuid"], "organization": who.get("organizationUuid")} \
        if isinstance(who, dict) and who.get("accountUuid") else None


def logins():
    """When the account of a login changes (a /login in any session), Claude Code drops the Remote
    Control link of every session on it and brings none back, so `handoff.py reconnect` does: it
    starts detached, with --all at the change and once a minute for LOOK seconds after it, then
    once a minute while a session is still owed its link (it was at work, or on a question). The
    change is read from the account files: this folder's own (CLAUDE_CONFIG_DIR set) and, for
    ~/.claude, the home's ~/.claude.json (the variable unset), their ids compared with what the
    last tick saw in flowkit/logins.json; a file is parsed only once it was rewritten. Nothing
    changed and nobody owed costs two stats and one directory read."""
    state = CLAUDE / "flowkit"
    files = [CLAUDE / ".claude.json"]
    if CLAUDE.resolve() == (Path.home() / ".claude").resolve():
        files.append(Path.home() / ".claude.json")
    try:
        seen = json.loads((state / "logins.json").read_text())
    except (OSError, ValueError):
        seen = {}
    if not isinstance(seen, dict):
        seen = {}
    now, changed, dirty = time.time(), False, False
    for path in files:
        try:
            st = path.stat()
        except OSError:
            continue
        was = seen.get(str(path)) if isinstance(seen.get(str(path)), dict) else {}
        if was.get("stat") == [st.st_mtime_ns, st.st_size]:
            continue
        who = account(path)
        if who and was.get("account") and who != was["account"]:
            seen["changed"], changed = now, True
        seen[str(path)] = {"stat": [st.st_mtime_ns, st.st_size], "account": who or was.get("account")}
        dirty = True
    try:
        if dirty:
            state.mkdir(parents=True, exist_ok=True)
            fresh = state / "logins.tmp"
            fresh.write_text(json.dumps(seen))
            os.replace(fresh, state / "logins.json")
        looking = now - (seen.get("changed") or 0) < LOOK
        if not looking and not any(name.endswith(".owed") for name in os.listdir(state / "remote")):
            return
    except OSError:
        return
    try:
        if not changed and now - (state / ".remote-tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        (state / ".remote-tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "handoff.py"), "reconnect",
                          *(["--all"] if looking else [])],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def relogged(rec):
    """The login a limit record's session stopped on is another account's now: its account file
    (<CLAUDE_CONFIG_DIR as the session had it>/.claude.json, ~/.claude.json when it had none) names
    other ids than the record keeps."""
    if not rec.get("account"):
        return False
    who = account(Path(rec.get("config") or Path.home()) / ".claude.json")
    return bool(who) and who != rec["account"]


def limits():
    """A session stopped on a usage limit needs its waiter (`handoff.py retry-wait`), which the
    StopFailure hook starts and which lives until the record goes: one that died is started again,
    at most once a minute. Never for a record its waiter is done with (continued, left to the user
    or to Claude Code's own wait) unless the account under its session changed since, which opens
    it again; never with limit resume off, or for a session that is gone. No record costs one
    directory read."""
    state = CLAUDE / "flowkit" / "retry"
    try:
        names = [e.name for e in os.scandir(state) if e.name.endswith(".json") and not e.name.startswith(".")]
    except OSError:
        return
    if not names:
        return
    try:
        if time.time() - (state / ".tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        (state / ".tick").touch()
    except OSError:
        return
    for name in names:
        try:
            rec = json.loads((state / name).read_text())
            if rec.get("kind") != "rate_limit" or not rec.get("resume") or \
                    (rec.get("handled") == rec.get("at") and not relogged(rec)):
                continue
            os.kill(int(rec["pid"]), 0)
        except (OSError, ValueError, TypeError, AttributeError, KeyError):
            continue
        try:
            with (state / f"{name[:-5]}.lock").open() as lock:  # its waiter holds an flock on it while it lives
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except FileNotFoundError:
            pass
        except OSError:
            continue
        try:
            subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "handoff.py"), "retry-wait", name[:-5]],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
        except OSError:
            pass


def remind():
    """With remind=on in handoff.conf, `handoff.py remind` starts detached at most once a minute: it
    tells the user what waits on them while they are neither away nor at the computer, and its own
    lock keeps one pass at a time. Off costs one read of handoff.conf."""
    if setting("remind") != "on":
        return
    state = CLAUDE / "flowkit"
    try:
        if time.time() - (state / ".remind-tick").stat().st_mtime < 60:
            return
    except OSError:
        pass
    try:
        state.mkdir(parents=True, exist_ok=True)
        (state / ".remind-tick").touch()
        subprocess.Popen([sys.executable, str(plugin_root() / "scripts" / "handoff.py"), "remind"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError:
        pass


def marks():
    """The status line `flowkit-tmux marks` prints once it has marked the panes and tabs and closed
    what autoclose lets it close; "" where tmux is not installed. The helper is the one beside this
    file (its own version: the copies in ~/.local/bin move together), else the plugin's."""
    if not shutil.which("tmux"):
        return ""
    helper = Path(__file__).resolve().parent / "flowkit-tmux"
    if not helper.is_file():
        helper = plugin_root() / "bin" / "flowkit-tmux"
    out = subprocess.run([sys.executable, str(helper), "marks"], stdin=subprocess.DEVNULL, capture_output=True,
                         text=True, timeout=MARKS_WAIT)
    if out.returncode:
        raise RuntimeError((out.stderr.strip().splitlines() or [f"exit {out.returncode}"])[-1])
    return out.stdout


JOBS = (drain, idle, watch, limits, logins, remind)  # each starts its work detached: none waits on tmux or claude


def cached():
    try:
        kept = json.loads(CACHE.read_text())
    except (OSError, ValueError):
        return {}
    return kept if isinstance(kept, dict) else {}


def tick(timer=False):
    """One pass: every job, then the marks, each on its own; what it kept, or None when another
    pass holds the lock (it is never waited for)."""
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    with CACHE.with_suffix(".lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return None
        failed, line = {}, ""
        for job in JOBS:
            try:
                job()
            except Exception as e:
                failed[job.__name__] = f"{type(e).__name__}: {e}"[:200]
        try:
            line = marks()
        except Exception as e:
            failed["marks"] = f"{type(e).__name__}: {e}"[:200]
        now = time.time()
        timed = now if timer else cached().get("timer")
        kept = {"at": now, "line": line, **({"timer": timed} if timed else {}), **({"failed": failed} if failed else {})}
        fresh = CACHE.with_suffix(".tmp")
        fresh.write_text(json.dumps(kept))
        os.replace(fresh, CACHE)
    return kept


def bar():
    """The status bar's job. tmux reruns a #() job at every redraw that falls in a new second, not
    every status-interval, so the line comes from what the last pass kept: always while a timer
    keeps the tick, else while it is younger than FRESH seconds. A run that overlaps another pass
    prints the kept line too."""
    kept = cached()
    now = time.time()
    try:
        timed = now - kept.get("timer", 0) < TIMED
        if not timed and now - kept.get("at", 0) >= FRESH:
            kept = tick() or kept
    except (OSError, TypeError):
        pass
    print(kept.get("line") or "", end="")


def ago(seconds):
    return f"{int(seconds)} s" if seconds < 120 else f"{int(seconds // 60)} min" if seconds < 7200 else f"{int(seconds // 3600)} h"


def status():
    """Who keeps the tick and how its last pass went; 1 when none ran in the last minute."""
    kept = cached()
    now = time.time()
    try:
        at, timed = float(kept.get("at") or 0), float(kept.get("timer") or 0)
    except (TypeError, ValueError):
        at = timed = 0
    if not at:
        print(f"tick: no pass yet ({CACHE} is not there)")
        return 1
    keeper = "kept by the timer" if now - timed < TIMED else "run from the tmux status bar or by hand: no timer kept it in the last minute"
    stopped = now - at >= TIMED
    print(f"tick: {'stopped, ' if stopped else ''}last pass {ago(now - at)} ago, {keeper}")
    print(f"line: {kept.get('line') or 'nothing waits on you in tmux'}")
    for job, why in (kept.get("failed") or {}).items():
        print(f"failed: {job}: {why}")
    return 1 if stopped else 0


def main(argv):
    if argv in ([], ["--timer"]):
        tick(timer=bool(argv))
    elif argv == ["bar"]:
        bar()
    elif argv == ["status"]:
        sys.exit(status())
    else:
        print(__doc__, file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
